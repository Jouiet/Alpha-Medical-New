CORE_METHODOLOGY="Frames -> Motion -> Implementation"
STRATEGY_PRINCIPLE="Use AI workflow concepts to create premium animated assets that are 100% compliant with existing Alpha Medical brand guidelines and technical infrastructure."
MANDATE_NO_NEW_APPS="TRUE"
MANDATE_TARGET_PLATFORM="Shopify Theme ID 140069830733 ONLY"

# ====================================================================================
# SECTION 2: PHASE 1 - VISUAL FOUNDATION (FRAMES)
# Objective: Generate "start" and "end" visual frames for key animations (e.g., hero banner, product feature callouts) that are fully compliant with Alpha Medical's established brand identity. This is the 'visual foundation' phase.
# ====================================================================================
PHASE1_TOOL_ANALOGY="Google Whisk / Nano Banana (Conceptually)"
PHASE1_INPUT_SOURCE_OF_TRUTH="ALPHA_MEDICAL_BRAND_GUIDELINES.md"
PHASE1_OBJECTIVE="Create static visual anchors (start/end frames) for animations."
PHASE1_ASSET_REQUIREMENT_1="Hero Banner Animation: A sequence showing a transition from a person in discomfort to relief, using brand-approved lifestyle photography style."
PHASE1_ASSET_REQUIREMENT_2="Product Feature Animation: A subtle zoom or focus shift on a key product feature (e.g., the support straps of a knee brace)."
PHASE1_VISUAL_PROMPT_ELEMENTS_COLOR_PALETTE="Primary: #4770db, Secondary: #0e1b4d, Background: #eff0f5, Text: #0e1b4d"
PHASE1_VISUAL_PROMPT_ELEMENTS_TYPOGRAPHY="Headings: Archivo Bold 700, Body: Questrial 400"
PHASE1_VISUAL_PROMPT_ELEMENTS_STYLE="Lighting: Natural, bright, soft shadows. Mood: Empowering, optimistic, trustworthy. Composition: Clean, professional, product-in-use."
PHASE1_VERIFICATION_CRITERIA="100% compliance with color palette. Correct font usage. Adherence to photography style. No off-brand elements."
PHASE1_OUTPUT="A set of verified, static .png or .jpg image pairs (start/end) ready for the motion phase."

# ====================================================================================
# SECTION 3: PHASE 2 - MOTION GENERATION & OPTIMIZATION
# Objective: Convert the static frames into fluid, premium-feeling animations and optimize them for web performance.
# ====================================================================================
PHASE2_TOOL_ANALOGY="Google Flow (Conceptually)"
PHASE2_OBJECTIVE="Animate the verified static frames and optimize the output for web."
PHASE2_MOTION_PROMPT_ELEMENTS="smooth_pacing, subtle_transitions, modern_premium_feel, no_distracting_artifacts, consistent_lighting"
PHASE2_CRITICAL_OPTIMIZATION_STEP="Convert final animation (e.g., .mp4) to a high-performance, scroll-controlled WebP sequence."
PHASE2_OPTIMIZATION_RATIONALE="WebP format allows for interactivity (scroll-based playback) while maintaining a small file size crucial for fast page loads."
PHASE2_VERIFICATION_CRITERIA_1="Animation is smooth and artifact-free."
PHASE2_VERIFICATION_CRITERIA_2="WebP file size is below performance budget (e.g., < 500KB for hero animation)."
PHASE2_VERIFICATION_CRITERIA_3="Animation loops correctly and frames are sequenced properly."
PHASE2_OUTPUT="Optimized .webp animation files ready for implementation."

# ====================================================================================
# SECTION 4: PHASE 3 - IMPLEMENTATION & VERIFICATION
# Objective: Integrate the animated WebP assets into the existing Alpha Medical Shopify theme without regressions and with empirical verification.
# ====================================================================================
PHASE3_TOOL_ANALOGY="Firebase Studio (Conceptually)"
PHASE3_IMPLEMENTATION_TARGET_THEME_ID="140069830733"
PHASE3_IMPLEMENTATION_METHOD="Directly modify theme files (e.g., `sections/hero.liquid`, `assets/base.css`) to include the WebP animation with JavaScript for scroll-based playback."
PHASE3_TECHNICAL_CHALLENGE="Implementing scroll-controlled animation requires custom JavaScript, which must be efficient and not conflict with existing theme scripts."
PHASE3_VERIFICATION_SCRIPT_IDEA="A script could be written to crawl the deployed preview site and verify that (1) no new external app scripts have been added, and (2) all color codes in the final rendered CSS are from the approved brand palette."
PHASE3_EMPIRICAL_VALIDATION_1="Visually inspect the preview on multiple devices (desktop, mobile) to confirm the animation is smooth, not 'janky'."
PHASE3_EMPIRICAL_VALIDATION_2="Run a performance audit (e.g., Lighthouse) on the preview page to ensure the animation has not negatively impacted Core Web Vitals."
PHASE3_NO_REGRESSION_TEST="Verify that existing functionality (e.g., 'Add to Cart' buttons, navigation) is completely unaffected."
PHASE3_OUTPUT="A modified Shopify theme with integrated, high-performance animations, validated against all factual and performance criteria."

