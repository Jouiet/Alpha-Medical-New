{% comment %}
  BUNDLE BUILDER - Combined Version (Search + URL Input)

  Method 1: Product search
  Method 2: Copy/paste product URL

  Discount: 35% OFF | Min: 3 products | Max: 4 products | Max Value: $500
{% endcomment %}

<div class="bundle-builder-combined" data-section-id="{{ section.id }}">
  <div class="page-width">

    {%- comment -%} HERO SECTION {%- endcomment -%}
    <div class="bundle-hero">
      <h1 class="bundle-hero__title">{{ section.settings.title | default: "Build Your Perfect Bundle" }}</h1>
      <p class="bundle-hero__subtitle">
        {{ section.settings.subtitle | default: "Select 3-4 products and get 35% OFF. When 10+ identical proposals, auto-created instantly!" }}
      </p>

      <div class="bundle-hero__stats">
        <div class="stat">
          <span class="stat-value">35%</span>
          <span class="stat-label">Discount</span>
        </div>
        <div class="stat">
          <span class="stat-value">10+</span>
          <span class="stat-label">Identical Proposals</span>
        </div>
        <div class="stat">
          <span class="stat-value">3-4</span>
          <span class="stat-label">Products</span>
        </div>
        <div class="stat">
          <span class="stat-value">$500</span>
          <span class="stat-label">Max Value</span>
        </div>
      </div>
    </div>

    {%- comment -%} METHOD SELECTOR {%- endcomment -%}
    <div class="method-selector">
      <h2 class="method-selector__title">Choose Your Selection Method:</h2>
      <div class="method-tabs">
        <button
          class="method-tab active"
          data-method="search"
        >
          <svg class="method-tab__icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M17.5 17.5L13.875 13.875M15.8333 9.16667C15.8333 12.8486 12.8486 15.8333 9.16667 15.8333C5.48477 15.8333 2.5 12.8486 2.5 9.16667C2.5 5.48477 5.48477 2.5 9.16667 2.5C12.8486 2.5 15.8333 5.48477 15.8333 9.16667Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span class="method-tab__label">Search Products</span>
          <span class="method-tab__desc">Browse & select</span>
        </button>

        <button
          class="method-tab"
          data-method="url"
        >
          <svg class="method-tab__icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M10.8333 9.16667L14.1667 5.83333M14.1667 5.83333H11.6667M14.1667 5.83333V8.33333M9.16667 3.33333H6.5C5.11929 3.33333 4 4.45262 4 5.83333V13.5C4 14.8807 5.11929 16 6.5 16H13.5C14.8807 16 16 14.8807 16 13.5V10.8333" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="method-tab__label">Paste URLs</span>
          <span class="method-tab__desc">Quick & precise</span>
        </button>
      </div>
    </div>

    {%- comment -%} MAIN INTERFACE {%- endcomment -%}
    <div class="bundle-main">

      {%- comment -%} LEFT PANEL: INPUT METHODS {%- endcomment -%}
      <div class="bundle-input-panel">

        {%- comment -%} METHOD 1: SEARCH PRODUCTS {%- endcomment -%}
        <div class="input-method active" data-method="search">
          <div class="method-header">
            <h3 class="method-title">
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                <path d="M17.5 17.5L13.875 13.875M15.8333 9.16667C15.8333 12.8486 12.8486 15.8333 9.16667 15.8333C5.48477 15.8333 2.5 12.8486 2.5 9.16667C2.5 5.48477 5.48477 2.5 9.16667 2.5C12.8486 2.5 15.8333 5.48477 15.8333 9.16667Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              Method 1: Search Products
            </h3>
            <p class="method-instructions">
              Type product name, category, or pain type (e.g., "knee support", "LED therapy", "posture")
            </p>
          </div>

          <div class="search-box">
            <input
              type="text"
              id="product-search-input"
              class="search-input"
              placeholder="Search: knee, ankle, posture, therapy..."
              autocomplete="off"
            >
            <svg class="search-icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M17.5 17.5L13.875 13.875M15.8333 9.16667C15.8333 12.8486 12.8486 15.8333 9.16667 15.8333C5.48477 15.8333 2.5 12.8486 2.5 9.16667C2.5 5.48477 5.48477 2.5 9.16667 2.5C12.8486 2.5 15.8333 5.48477 15.8333 9.16667Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <div id="search-results" class="search-results"></div>

          <div class="method-help">
            <p><strong>How to use:</strong></p>
            <ol>
              <li>Type product name or category</li>
              <li>Click "+ Add" on products you want</li>
              <li>Product appears in your bundle →</li>
            </ol>
          </div>
        </div>

        {%- comment -%} METHOD 2: URL INPUT {%- endcomment -%}
        <div class="input-method" data-method="url">
          <div class="method-header">
            <h3 class="method-title">
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                <path d="M10.8333 9.16667L14.1667 5.83333M14.1667 5.83333H11.6667M14.1667 5.83333V8.33333M9.16667 3.33333H6.5C5.11929 3.33333 4 4.45262 4 5.83333V13.5C4 14.8807 5.11929 16 6.5 16H13.5C14.8807 16 16 14.8807 16 13.5V10.8333" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Method 2: Paste Product URLs
            </h3>
            <p class="method-instructions">
              Copy product URLs from our catalog and paste them below for quick bundle creation
            </p>
          </div>

          <div class="url-inputs">
            <div class="url-input-group">
              <label class="url-label">
                <span class="url-label-number">
                  <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                    <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2" fill="none"/>
                    <text x="10" y="14" text-anchor="middle" fill="currentColor" font-size="10" font-weight="bold">1</text>
                  </svg>
                  Product #1
                </span>
                <span class="url-label-status" id="url-status-1"></span>
              </label>
              <div class="url-input-wrapper">
                <input
                  type="url"
                  class="url-input"
                  id="url-input-1"
                  placeholder="Paste URL here (e.g., alphamedical.shop/products/knee-brace)"
                  data-product-number="1"
                >
                <button type="button" class="paste-btn" data-input-id="url-input-1" title="Paste from clipboard">
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                    <path d="M8 3C8 2.44772 8.44772 2 9 2H11C11.5523 2 12 2.44772 12 3V4H8V3Z" fill="currentColor"/>
                    <path d="M6 4V5H4C3.44772 5 3 5.44772 3 6V17C3 17.5523 3.44772 18 4 18H16C16.5523 18 17 17.5523 17 17V6C17 5.44772 16.5523 5 16 5H14V4H16C17.1046 4 18 4.89543 18 6V17C18 18.1046 17.1046 19 16 19H4C2.89543 19 2 18.1046 2 17V6C2 4.89543 2.89543 4 4 4H6Z" fill="currentColor"/>
                  </svg>
                </button>
              </div>
            </div>

            <div class="url-input-group">
              <label class="url-label">
                <span class="url-label-number">
                  <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                    <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2" fill="none"/>
                    <text x="10" y="14" text-anchor="middle" fill="currentColor" font-size="10" font-weight="bold">2</text>
                  </svg>
                  Product #2
                </span>
                <span class="url-label-status" id="url-status-2"></span>
              </label>
              <div class="url-input-wrapper">
                <input
                  type="url"
                  class="url-input"
                  id="url-input-2"
                  placeholder="Paste URL here"
                  data-product-number="2"
                >
                <button type="button" class="paste-btn" data-input-id="url-input-2" title="Paste from clipboard">
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                    <path d="M8 3C8 2.44772 8.44772 2 9 2H11C11.5523 2 12 2.44772 12 3V4H8V3Z" fill="currentColor"/>
                    <path d="M6 4V5H4C3.44772 5 3 5.44772 3 6V17C3 17.5523 3.44772 18 4 18H16C16.5523 18 17 17.5523 17 17V6C17 5.44772 16.5523 5 16 5H14V4H16C17.1046 4 18 4.89543 18 6V17C18 18.1046 17.1046 19 16 19H4C2.89543 19 2 18.1046 2 17V6C2 4.89543 2.89543 4 4 4H6Z" fill="currentColor"/>
                  </svg>
                </button>
              </div>
            </div>

            <div class="url-input-group">
              <label class="url-label">
                <span class="url-label-number">
                  <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                    <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2" fill="none"/>
                    <text x="10" y="14" text-anchor="middle" fill="currentColor" font-size="10" font-weight="bold">3</text>
                  </svg>
                  Product #3
                </span>
                <span class="url-label-status" id="url-status-3"></span>
              </label>
              <div class="url-input-wrapper">
                <input
                  type="url"
                  class="url-input"
                  id="url-input-3"
                  placeholder="Paste URL here"
                  data-product-number="3"
                >
                <button type="button" class="paste-btn" data-input-id="url-input-3" title="Paste from clipboard">
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                    <path d="M8 3C8 2.44772 8.44772 2 9 2H11C11.5523 2 12 2.44772 12 3V4H8V3Z" fill="currentColor"/>
                    <path d="M6 4V5H4C3.44772 5 3 5.44772 3 6V17C3 17.5523 3.44772 18 4 18H16C16.5523 18 17 17.5523 17 17V6C17 5.44772 16.5523 5 16 5H14V4H16C17.1046 4 18 4.89543 18 6V17C18 18.1046 17.1046 19 16 19H4C2.89543 19 2 18.1046 2 17V6C2 4.89543 2.89543 4 4 4H6Z" fill="currentColor"/>
                  </svg>
                </button>
              </div>
            </div>

            <div class="url-input-group">
              <label class="url-label">
                <span class="url-label-number">
                  <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                    <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2" fill="none"/>
                    <text x="10" y="14" text-anchor="middle" fill="currentColor" font-size="10" font-weight="bold">4</text>
                  </svg>
                  Product #4 <span class="optional-badge">Optional</span>
                </span>
                <span class="url-label-status" id="url-status-4"></span>
              </label>
              <div class="url-input-wrapper">
                <input
                  type="url"
                  class="url-input"
                  id="url-input-4"
                  placeholder="Paste URL here (optional)"
                  data-product-number="4"
                >
                <button type="button" class="paste-btn" data-input-id="url-input-4" title="Paste from clipboard">
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                    <path d="M8 3C8 2.44772 8.44772 2 9 2H11C11.5523 2 12 2.44772 12 3V4H8V3Z" fill="currentColor"/>
                    <path d="M6 4V5H4C3.44772 5 3 5.44772 3 6V17C3 17.5523 3.44772 18 4 18H16C16.5523 18 17 17.5523 17 17V6C17 5.44772 16.5523 5 16 5H14V4H16C17.1046 4 18 4.89543 18 6V17C18 18.1046 17.1046 19 16 19H4C2.89543 19 2 18.1046 2 17V6C2 4.89543 2.89543 4 4 4H6Z" fill="currentColor"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="method-help url-help">
            <div class="help-header">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="2"/>
                <path d="M10 14V14.01M10 6V11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <strong>How to get product URLs:</strong>
            </div>
            <ol>
              <li>Visit our <a href="/collections/all" target="_blank" rel="noopener">product catalog</a></li>
              <li>Click on any product you want in your bundle</li>
              <li>Copy the URL from your browser's address bar</li>
              <li>Click the <svg width="14" height="14" viewBox="0 0 20 20" fill="none" style="display:inline;vertical-align:middle"><path d="M8 3C8 2.44772 8.44772 2 9 2H11C11.5523 2 12 2.44772 12 3V4H8V3Z" fill="currentColor"/></svg> paste button or paste directly into the input</li>
            </ol>
            <p class="method-tip">
              💡 <strong>Tip:</strong> You can also paste URLs manually using Ctrl+V (Windows) or Cmd+V (Mac)
            </p>
          </div>
        </div>

      </div>

      {%- comment -%} RIGHT PANEL: SELECTED BUNDLE {%- endcomment -%}
      <div class="bundle-selection-panel">
        <h2 class="panel-title">Your Bundle (<span id="selected-count">0</span>/4)</h2>

        {%- comment -%} Selected Products List {%- endcomment -%}
        <div id="selected-products" class="selected-products">
          <div class="empty-state">
            <svg class="empty-icon" width="48" height="48" viewBox="0 0 48 48" fill="none">
              <path d="M8 12L20 4L32 12M8 12L8 36L20 44M8 12L20 20M20 44L32 36L32 12M20 44L20 20M32 12L20 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <p>Select 3-4 products using search or URL method</p>
          </div>
        </div>

        {%- comment -%} Price Summary {%- endcomment -%}
        <div id="price-summary" class="price-summary" style="display: none;">
          <div class="price-row">
            <span>Total Regular Price:</span>
            <span id="regular-price">$0.00</span>
          </div>
          <div class="price-row bundle-price-row">
            <span>Bundle Price (35% OFF):</span>
            <span id="bundle-price" class="bundle-price">$0.00</span>
          </div>
          <div class="price-row savings-row">
            <span>You Save:</span>
            <span id="savings" class="savings">$0.00</span>
          </div>
        </div>

        {%- comment -%} Max Value Warning {%- endcomment -%}
        <div id="max-value-warning" class="warning-message" style="display: none;">
          <svg class="warning-icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M10 6V10M10 14H10.01M19 10C19 14.9706 14.9706 19 10 19C5.02944 19 1 14.9706 1 10C1 5.02944 5.02944 1 10 1C14.9706 1 19 5.02944 19 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Bundle exceeds $500 maximum. Please remove a product.</span>
        </div>

        {%- comment -%} SUBMISSION FORM {%- endcomment -%}
        <div id="submission-form-container" style="display: none;">
          {% form 'contact', class: 'bundle-proposal-form' %}

            {%- if form.posted_successfully? -%}
              <div class="form-success">
                <svg class="success-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <h3>Bundle Proposal Submitted!</h3>
                <p>We'll notify you when {{ section.settings.threshold | default: 10 }}+ customers request this bundle.</p>
              </div>
            {%- elsif form.errors -%}
              <div class="form-error">
                <h3>Submission Error</h3>
                <p>{{ form.errors | default_errors }}</p>
              </div>
            {%- endif -%}

            <div class="form-group">
              <label for="contact-email">
                Your Email <span class="required">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="contact[email]"
                class="form-input"
                placeholder="your@email.com"
                required
              >
              <p class="form-help">We'll notify you when your bundle is created</p>
            </div>

            <input type="hidden" name="contact[subject]" value="Bundle Proposal">
            <input type="hidden" id="bundle-data-json" name="contact[body]" value="">
            <input type="hidden" id="bundle-method" name="contact[method]" value="">

            <div class="form-group commitment-group">
              <label class="checkbox-label">
                <input
                  type="checkbox"
                  id="commitment-checkbox"
                  required
                >
                <span class="checkbox-text">
                  I understand this is a proposal (not a purchase). If {{ section.settings.threshold | default: 10 }}+ customers request this bundle, you'll create it and notify me.
                </span>
              </label>
            </div>

            <button
              type="submit"
              id="submit-proposal-btn"
              class="submit-button"
              disabled
            >
              Submit Bundle Proposal
            </button>

            <p class="form-note">
              Maximum {{ section.settings.monthly_limit | default: 3 }} proposals per month · 3-5 business day review
            </p>

          {% endform %}
        </div>

      </div>
    </div>

    {%- comment -%} HOW IT WORKS {%- endcomment -%}
    <div class="how-it-works">
      <h2 class="section-title">How It Works</h2>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <h3>Choose Method</h3>
          <p>Search products or paste URLs - whichever you prefer!</p>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <h3>Select 3-4 Products</h3>
          <p>Pick products you want bundled together</p>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <h3>See 35% Savings</h3>
          <p>Automatic discount calculated in real-time</p>
        </div>
        <div class="step">
          <div class="step-number">4</div>
          <h3>Submit Proposal</h3>
          <p>When {{ section.settings.threshold | default: 10 }}+ customers want it, we create it!</p>
        </div>
      </div>
    </div>

  </div>
</div>

{%- comment -%} PRELOAD PRODUCTS DATA {%- endcomment -%}
<script>
  window.BUNDLE_BUILDER_PRODUCTS = [];
  window.BUNDLE_BUILDER_CONFIG = {
    minProducts: 3,
    maxProducts: 4,
    maxValue: 500,
    discountPercent: 35,
    threshold: {{ section.settings.threshold | default: 10 }},
    monthlyLimit: {{ section.settings.monthly_limit | default: 3 }}
  };
</script>

{% paginate collections.all.products by 250 %}
  <script>
    (function() {
      const products = [
        {% for product in collections.all.products %}
          {
            id: {{ product.id | json }},
            handle: {{ product.handle | json }},
            title: {{ product.title | json }},
            price: {{ product.price | json }},
            image: {{ product.featured_image | img_url: '200x200' | json }},
            url: {{ product.url | json }},
            productType: {{ product.type | json }},
            vendor: {{ product.vendor | json }},
            available: {{ product.available | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ];
      window.BUNDLE_BUILDER_PRODUCTS = window.BUNDLE_BUILDER_PRODUCTS.concat(products);
    })();
  </script>
{% endpaginate %}

{%- comment -%} LOAD BUNDLE BUILDER CSS {%- endcomment -%}
{{ 'bundle-builder-combined.css' | asset_url | stylesheet_tag }}

{%- comment -%} LOAD BUNDLE BUILDER JAVASCRIPT {%- endcomment -%}
<script src="{{ 'bundle-builder-combined.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Bundle Builder Combined",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Hero Title",
      "default": "Build Your Perfect Bundle"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Hero Subtitle",
      "default": "Select 3-4 products and get 35% OFF. When 10+ customers request the same bundle, we'll create it!"
    },
    {
      "type": "range",
      "id": "threshold",
      "label": "Creation Threshold (votes)",
      "min": 5,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "monthly_limit",
      "label": "Monthly Proposal Limit",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Bundle Builder Combined"
    }
  ]
}
{% endschema %}
