{% schema %}
{
  "name": "Bundles Collection",
  "settings": [
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Complete Care Bundles"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Curated medical equipment packages designed for your specific needs. Save 35% OFF on every bundle with free shipping."
    },
    {
      "type": "checkbox",
      "id": "show_why_bundles",
      "label": "Show 'Why Bundles' Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Show FAQ Section",
      "default": true
    },
    {
      "type": "select",
      "id": "default_sort",
      "label": "Default Sort Order",
      "options": [
