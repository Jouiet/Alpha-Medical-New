        <h3 class="filter-title">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M2 6C2 4.89543 2.89543 4 4 4H16C17.1046 4 18 4.89543 18 6V14C18 15.1046 17.1046 16 16 16H4C2.89543 16 2 15.1046 2 14V6Z" stroke="currentColor" stroke-width="2"/>
            <path d="M6 8H14M6 12H10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Filter by Price Range
        </h3>

        <div class="tier-tabs">
          <button class="tier-tab active" data-tier="all" onclick="bundlesFilter.filterTier('all')">
