{% comment %}
  ALPHA MEDICAL - BUNDLES COLLECTION PAGE
  15 Bundles with Persona + Tier Filters
  35% Discount Strategy
{% endcomment %}

<div class="bundles-page">
  {%- comment -%} Hero Section {%- endcomment -%}
  <section class="bundles-hero">
    <div class="page-width">
      <div class="hero-content">
        <span class="hero-badge">💊 Medical Equipment Bundles</span>
        <h1 class="hero-title">Complete Care Bundles</h1>
        <p class="hero-subtitle">
          Curated medical equipment packages designed for your specific needs.
          Save <strong>35% OFF</strong> on every bundle with free shipping.
        </p>

        <div class="hero-stats">
          <div class="stat">
            <span class="stat-value">15</span>
            <span class="stat-label">Expert Bundles</span>
          </div>
          <div class="stat">
            <span class="stat-value">35%</span>
            <span class="stat-label">Guaranteed Savings</span>
          </div>
          <div class="stat">
            <span class="stat-value">8</span>
            <span class="stat-label">Patient Personas</span>
          </div>
          <div class="stat">
            <span class="stat-value">4</span>
            <span class="stat-label">Price Tiers</span>
          </div>
        </div>

        <div class="hero-cta">
          <a href="#bundles-grid" class="btn btn-primary">Browse Bundles</a>
          <a href="/pages/bundle-creator" class="btn btn-secondary">Build Your Own Bundle</a>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Why Bundles Section {%- endcomment -%}
  <section class="why-bundles">
    <div class="page-width">
      <h2 class="section-title">Why Choose Bundle Packages?</h2>

      <div class="benefits-grid">
        <div class="benefit-card">
          <div class="benefit-icon">💰</div>
          <h3>Save 35% Guaranteed</h3>
          <p>Every bundle offers exactly 35% OFF regular prices. No exceptions, no tricks.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">🎯</div>
          <h3>Expertly Curated</h3>
          <p>Each bundle designed by medical professionals for specific patient needs and conditions.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">🔧</div>
          <h3>Complete Solutions</h3>
          <p>All complementary products work together for maximum therapeutic benefit.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">🚚</div>
          <h3>Free Shipping</h3>
          <p>All bundles ship free. Get everything you need in one delivery.</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Filters Section {%- endcomment -%}
  <section id="bundles-grid" class="bundles-filters">
    <div class="page-width">
      <h2 class="section-title">Find Your Perfect Bundle</h2>

      {%- comment -%} Persona Filter Tabs {%- endcomment -%}
      <div class="filter-section">
        <h3 class="filter-title">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M10 10C12.7614 10 15 7.76142 15 5C15 2.23858 12.7614 0 10 0C7.23858 0 5 2.23858 5 5C5 7.76142 7.23858 10 10 10Z" fill="currentColor"/>
            <path d="M10 12C4.477 12 0 14.477 0 17.5V20H20V17.5C20 14.477 15.523 12 10 12Z" fill="currentColor"/>
          </svg>
          Filter by Patient Type
        </h3>

        <div class="persona-tabs">
          <button class="persona-tab active" data-persona="all" onclick="bundlesFilter.filterPersona('all')">
            <span class="tab-label">All Bundles</span>
            <span class="tab-count">15</span>
          </button>

          <button class="persona-tab" data-persona="office-worker" onclick="bundlesFilter.filterPersona('office-worker')">
            <span class="tab-icon">💼</span>
            <span class="tab-label">Office Worker</span>
            <span class="tab-count">3</span>
          </button>

          <button class="persona-tab" data-persona="chronic-pain" onclick="bundlesFilter.filterPersona('chronic-pain')">
            <span class="tab-icon">🩹</span>
            <span class="tab-label">Chronic Pain</span>
            <span class="tab-count">3</span>
          </button>

          <button class="persona-tab" data-persona="athlete" onclick="bundlesFilter.filterPersona('athlete')">
            <span class="tab-icon">🏃</span>
            <span class="tab-label">Active Athlete</span>
            <span class="tab-count">2</span>
          </button>

          <button class="persona-tab" data-persona="senior" onclick="bundlesFilter.filterPersona('senior')">
            <span class="tab-icon">👴</span>
            <span class="tab-label">Senior Care</span>
            <span class="tab-count">2</span>
          </button>

          <button class="persona-tab" data-persona="post-surgery" onclick="bundlesFilter.filterPersona('post-surgery')">
            <span class="tab-icon">🏥</span>
            <span class="tab-label">Post-Surgery</span>
            <span class="tab-count">1</span>
          </button>

          <button class="persona-tab" data-persona="manual-labor" onclick="bundlesFilter.filterPersona('manual-labor')">
            <span class="tab-icon">🔨</span>
            <span class="tab-label">Manual Labor</span>
            <span class="tab-count">1</span>
          </button>

          <button class="persona-tab" data-persona="rehab" onclick="bundlesFilter.filterPersona('rehab')">
            <span class="tab-icon">♿</span>
            <span class="tab-label">Rehabilitation</span>
            <span class="tab-count">1</span>
          </button>

          <button class="persona-tab" data-persona="beauty" onclick="bundlesFilter.filterPersona('beauty')">
            <span class="tab-icon">✨</span>
            <span class="tab-label">Beauty & Wellness</span>
            <span class="tab-count">1</span>
          </button>
