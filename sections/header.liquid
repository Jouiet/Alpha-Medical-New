<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     ALPHA MEDICAL LOGO ANIMATION - Session 103 v2
     CONTINUOUS LOOP animation - always visible, intensified on hover
     ═══════════════════════════════════════════════════════════════════════════ */

  /* Entrance Animation Keyframes */
  @keyframes logoEntrance {
    0% {
      opacity: 0;
      transform: translateY(-20px) scale(0.8);
      filter: blur(10px);
    }
    50% {
      opacity: 0.8;
      filter: blur(2px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  /* CONTINUOUS Glow Pulse - Always Active */
  @keyframes logoContinuousGlow {
    0%, 100% {
      filter: drop-shadow(0 0 8px rgba(71, 112, 219, 0.5))
              drop-shadow(0 0 20px rgba(71, 112, 219, 0.25));
      transform: scale(1);
    }
    50% {
      filter: drop-shadow(0 0 15px rgba(71, 112, 219, 0.7))
              drop-shadow(0 0 35px rgba(71, 112, 219, 0.35));
      transform: scale(1.03);
    }
  }

  /* CONTINUOUS Shimmer Effect - Always Running */
  @keyframes logoShimmerContinuous {
    0% {
      background-position: -200% center;
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
    100% {
      background-position: 200% center;
      opacity: 0.6;
    }
  }

  /* Hover Intensified Glow */
  @keyframes hoverGlowIntense {
    0%, 100% {
      filter: drop-shadow(0 0 20px rgba(71, 112, 219, 0.8))
              drop-shadow(0 0 40px rgba(71, 112, 219, 0.4))
              drop-shadow(0 0 60px rgba(71, 112, 219, 0.2));
      transform: translateY(-3px) scale(1.04);
    }
    50% {
      filter: drop-shadow(0 0 30px rgba(71, 112, 219, 1))
              drop-shadow(0 0 55px rgba(71, 112, 219, 0.5))
              drop-shadow(0 0 80px rgba(71, 112, 219, 0.25));
      transform: translateY(-5px) scale(1.06);
    }
  }

  /* Logo Container - Base Styles */
  .header__heading-link {
    position: relative;
    display: inline-block;
    perspective: 1000px;
  }

  /* Logo Image - CONTINUOUS Animation */
  .header__heading-logo {
    /* Entrance then CONTINUOUS glow loop */
    animation: logoEntrance 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
               logoContinuousGlow 3s ease-in-out 0.8s infinite;

    /* Smooth Transitions for hover enhancement */
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);

    /* Enable GPU Acceleration */
    will-change: transform, filter;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  /* Hover State - INTENSIFIED Animation */
  .header__heading-link:hover .header__heading-logo {
    animation: hoverGlowIntense 2s ease-in-out infinite;
  }

  /* Active/Click State */
  .header__heading-link:active .header__heading-logo {
    transform: translateY(-2px) scale(1.02);
    filter: drop-shadow(0 0 25px rgba(71, 112, 219, 0.9));
    transition: transform 0.1s ease-out, filter 0.1s ease-out;
  }

  /* Focus State for Accessibility */
  .header__heading-link:focus-visible .header__heading-logo {
    outline: 2px solid #4770db;
    outline-offset: 8px;
    border-radius: 4px;
  }

  /* CONTINUOUS Shimmer Overlay - Always Visible */
  .header__heading-link::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0) 35%,
      rgba(255, 255, 255, 0.35) 50%,
      rgba(255, 255, 255, 0) 65%,
      transparent 100%
    );
    background-size: 200% 100%;
    animation: logoShimmerContinuous 4s ease-in-out 1.5s infinite;
    pointer-events: none;
    opacity: 0.7; /* Always visible now */
    border-radius: 8px;
  }

  /* Hover - Intensify shimmer */
  .header__heading-link:hover::after {
    opacity: 1;
    animation: logoShimmerContinuous 2.5s ease-in-out infinite; /* Faster on hover */
  }

  /* Scrolled State - Slightly calmer but still visible */
  .scrolled-past-header .header__heading-logo {
    animation: logoContinuousGlow 4s ease-in-out infinite;
  }

  /* Reduced Motion Preference - Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .header__heading-logo {
      animation: none;
      filter: drop-shadow(0 0 10px rgba(71, 112, 219, 0.4));
      transition: transform 0.2s ease, filter 0.2s ease;
    }
    .header__heading-link::after {
      animation: none;
      opacity: 0;
    }
    .header__heading-link:hover .header__heading-logo {
      animation: none;
      transform: scale(1.03);
      filter: drop-shadow(0 0 15px rgba(71, 112, 219, 0.6));
    }
  }

  /* Mobile Optimization - Continuous but lighter */
  @media screen and (max-width: 749px) {
    .header__heading-logo {
      animation: logoEntrance 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
                 logoContinuousGlow 4s ease-in-out 0.6s infinite;
    }
    .header__heading-link::after {
      opacity: 0.5; /* Lighter shimmer on mobile */
      animation: logoShimmerContinuous 5s ease-in-out 2s infinite;
    }
    .header__heading-link:hover .header__heading-logo {
      transform: scale(1.04);
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     END LOGO ANIMATION v2 - CONTINUOUS LOOP
     ═══════════════════════════════════════════════════════════════════════════ */

  /* Logo size reduction - 30% smaller - Session 106 Part 2 - INLINE FIX */
  .header__heading-logo-wrapper {
    width: 70% !important;
    max-width: 70% !important;
  }

  /* Mobile optimization - keep logo readable */
  @media screen and (max-width: 749px) {
    .header__heading-logo-wrapper {
      width: 60% !important;
      max-width: 60% !important;
    }
  }

  /* Tablet optimization */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .header__heading-logo-wrapper {
      width: 65% !important;
      max-width: 65% !important;
    }
  }

  /* Desktop - full 30% reduction */
  @media screen and (min-width: 990px) {
    .header__heading-logo-wrapper {
      width: 70% !important;
      max-width: 70% !important;
    }
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 52.5% !important; /* 75% of 70% = 52.5% */
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  /* Header menu spacing fix - Session 67 - Force cache refresh 2025-11-05 */
  .list-menu__item--link,
  .header__menu-item {
    text-decoration: none !important;
    padding-bottom: 1rem !important;
    padding-top: 1rem !important;
    padding-left: 1rem !important;
    padding-right: 1rem !important;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link,
    .header__menu-item {
      padding-bottom: 0.5rem !important;
      padding-top: 0.5rem !important;
      padding-left: 1rem !important;
      padding-right: 1rem !important;
    }
  }

  /* Big Dealz menu link - Red color #FF3131 - Session 73 Cont 48 Part 14 */
  .header__menu-item[href*="bundles"],
  .list-menu__item--link[href*="bundles"],
  a[href*="/collections/bundles-and-kits"],
  a[href*="/collections/bundles"] {
    color: #FF3131 !important;
    font-weight: 600 !important;
  }

  /* ========== MOBILE DRAWER OPTIMIZATION - Session 90 ========== */

  /* Big Dealz RED - ID selector for MAXIMUM specificity */
  #menu-drawer a[href*="bundles"],
  #menu-drawer a[href*="medical-equipment-bundles"],
  #menu-drawer .menu-drawer__menu-item[href*="bundles"],
  #HeaderDrawer-our-bundles {
    color: #FF3131 !important;
    font-weight: 600 !important;
  }

  /* Drawer background - full opacity, no transparency */
  .menu-drawer {
    background-color: rgb(var(--color-background)) !important;
  }

  .menu-drawer__inner-container {
    background-color: rgb(var(--color-background)) !important;
  }

  /* Drawer width - 100% on mobile for clean look */
  @media screen and (max-width: 749px) {
    .menu-drawer {
      width: 100% !important;
    }
  }

  /* Menu item spacing - better readability */
  .menu-drawer__menu-item {
    padding: 1.4rem 3rem !important;
    font-size: 1.6rem !important;
    letter-spacing: 0.02em;
  }

  /* Hover state consistency */
  .menu-drawer__menu-item:hover,
  .menu-drawer__menu-item:focus {
    background-color: rgba(var(--color-foreground), 0.06) !important;
  }

  /* Close button (X) styling */
  .menu-drawer__close-button {
    background-color: transparent !important;
  }

  /* Utility links (country selector) - cleaner */
  .menu-drawer__utility-links {
    background-color: rgba(var(--color-foreground), 0.02) !important;
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
  }

  /* ========== END MOBILE DRAWER OPTIMIZATION ========== */
</style>

<script>
  // Replace "Bundles" with "Big Dealz" in header menu - Session 73 Cont 48 Part 14
  document.addEventListener('DOMContentLoaded', function() {
    const menuLinks = document.querySelectorAll('a[href*="/collections/bundles"], a[href*="bundles"]');
    menuLinks.forEach(link => {
      if (link.textContent.trim().toLowerCase().includes('bundle')) {
        link.textContent = 'Big Dealz';
      }
    });
  });
</script>

