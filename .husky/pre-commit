#!/bin/sh
# Alpha Medical - Pre-commit Hook
# Validates Liquid templates before commit
# Version: 1.0.0 | Session 143 | 23/01/2026

echo "🔍 Running pre-commit validation..."

# Check if theme files are staged
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.(liquid|json)$")

if [ -z "$STAGED_FILES" ]; then
    echo "✅ No theme files staged - skipping validation"
    exit 0
fi

echo "📁 Found staged theme files:"
echo "$STAGED_FILES" | head -10

# Run theme check (if available)
if command -v npx &> /dev/null; then
    echo ""
    echo "🎨 Running Shopify Theme Check..."
    npx @shopify/theme-check --fail-level error . 2>/dev/null
    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ COMMIT BLOCKED - Theme check failed"
        echo ""
        echo "Fix the errors or bypass with: git commit --no-verify"
        exit 1
    fi
    echo "✅ Theme check passed"
fi

echo ""
echo "✅ All validations passed"
exit 0
