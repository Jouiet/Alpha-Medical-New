#!/bin/bash

# PRE-TOOL-USE HOOK - CONSTRAINT ENFORCEMENT
# Purpose: Block forbidden actions BEFORE execution
# Format: Claude Code official format (JSON via stdin, exit 2 to block)
# Enforces: Core constraints from .claude/memory/01-core-constraints.md

# Color codes for stderr output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Read JSON input from stdin
INPUT=$(cat)

# Parse JSON fields
TOOL_NAME=$(echo "$INPUT" | jq -r '.tool_name // empty' 2>/dev/null)
TOOL_INPUT=$(echo "$INPUT" | jq -r '.tool_input // {}' 2>/dev/null)

# ============================================================================
# CRITICAL CONSTRAINT #1: Block Product Modifications
# ============================================================================

if [[ "$TOOL_NAME" == "Edit" ]] || [[ "$TOOL_NAME" == "Write" ]]; then
    FILE_PATH=$(echo "$TOOL_INPUT" | jq -r '.file_path // empty' 2>/dev/null)

    # Block modifications to product files
    if [[ "$FILE_PATH" =~ products/ ]] || [[ "$FILE_PATH" =~ product ]]; then
        echo -e "${RED}❌ BLOCKED: Product file modification forbidden${NC}" >&2
        echo "" >&2
        echo "File: $FILE_PATH" >&2
        echo "Reason: Owner handles ALL pricing/product strategy" >&2
        echo "Constraint: .claude/memory/01-core-constraints.md" >&2
        echo "" >&2
        echo "Your role: 100% MARKETING automation ONLY" >&2
        exit 2  # Exit code 2 blocks the tool call
    fi

    # Block modifications to pricing/inventory files
    if [[ "$FILE_PATH" =~ price ]] || [[ "$FILE_PATH" =~ inventory ]] || [[ "$FILE_PATH" =~ variant ]]; then
        echo -e "${RED}❌ BLOCKED: Pricing/inventory modification forbidden${NC}" >&2
        echo "" >&2
        echo "File: $FILE_PATH" >&2
        echo "Reason: Owner handles ALL pricing decisions" >&2
        exit 2
    fi
fi

# ============================================================================
# CRITICAL CONSTRAINT #2: Block PayPal Activation
# ============================================================================

# Check for PayPal activation attempts in tool input
if echo "$TOOL_INPUT" | grep -iq "paypal"; then
    if echo "$TOOL_INPUT" | grep -iq "enable\|activate\|true"; then
        echo -e "${RED}❌ BLOCKED: PayPal activation forbidden${NC}" >&2
        echo "" >&2
        echo "Reason: Owner explicitly forbids PayPal" >&2
        echo "Allowed: Stripe, Apple Pay, Google Pay ONLY" >&2
        echo "Constraint: .claude/memory/01-core-constraints.md" >&2
        exit 2
    fi
fi

# ============================================================================
# CRITICAL CONSTRAINT #3: Block Credentials Commits
# ============================================================================

if [[ "$TOOL_NAME" == "Bash" ]]; then
    COMMAND=$(echo "$TOOL_INPUT" | jq -r '.command // empty' 2>/dev/null)

    # Block git commits of .env files
    if echo "$COMMAND" | grep -q "git.*commit" || echo "$COMMAND" | grep -q "git.*add"; then
        if echo "$COMMAND" | grep -Eq "\\.env|credentials|secrets"; then
            echo -e "${RED}❌ BLOCKED: Attempting to commit credentials${NC}" >&2
            echo "" >&2
            echo "Reason: NEVER commit .env, credentials, or secrets files" >&2
            echo "Security: Use environment variables or GitHub Secrets" >&2
            echo "Constraint: .claude/memory/01-core-constraints.md" >&2
            exit 2
        fi
    fi
fi

# ============================================================================
# CRITICAL CONSTRAINT #4: Block Supplier/Fulfillment Changes
# ============================================================================

if [[ "$TOOL_NAME" == "Edit" ]] || [[ "$TOOL_NAME" == "Write" ]]; then
    FILE_PATH=$(echo "$TOOL_INPUT" | jq -r '.file_path // empty' 2>/dev/null)

    # Block DSers or fulfillment config changes
    if [[ "$FILE_PATH" =~ dsers ]] || [[ "$FILE_PATH" =~ fulfillment ]] || [[ "$FILE_PATH" =~ supplier ]]; then
        echo -e "${RED}❌ BLOCKED: Supplier/fulfillment modification forbidden${NC}" >&2
        echo "" >&2
        echo "File: $FILE_PATH" >&2
        echo "Reason: Owner handles ALL supplier relationships" >&2
        exit 2
    fi
fi

# ============================================================================
# WARNING: Theme Layout Changes (Non-Blocking)
# ============================================================================

if [[ "$TOOL_NAME" == "Edit" ]]; then
    FILE_PATH=$(echo "$TOOL_INPUT" | jq -r '.file_path // empty' 2>/dev/null)

    if [[ "$FILE_PATH" =~ layout/ ]] || [[ "$FILE_PATH" =~ sections/ ]]; then
        echo -e "${YELLOW}⚠️  WARNING: Modifying theme layout file${NC}" >&2
        echo "" >&2
        echo "File: $FILE_PATH" >&2
        echo "Recommendation: Ask user first for major layout changes" >&2
        echo "Allowed: Minor fixes, tracking additions, SEO improvements" >&2
        echo "" >&2
        # Allow but warn - not blocking (exit 1 = non-blocking warning)
        # Continue to allow (exit 0)
    fi
fi

# ============================================================================
# All Checks Passed - Allow Operation
# ============================================================================

# In verbose mode, this message will be shown
echo -e "${GREEN}✅ Constraint check passed${NC}" >&2
exit 0
