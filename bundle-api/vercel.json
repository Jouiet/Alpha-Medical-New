{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/$1.py"
    }
  ],
  "env": {
    "SHOPIFY_DOMAIN": "@shopify_domain",
    "SHOPIFY_ADMIN_ACCESS_TOKEN": "@shopify_admin_token",
    "BUNDLE_CREATOR_PAGE_GID": "@bundle_creator_page_gid"
  }
}
