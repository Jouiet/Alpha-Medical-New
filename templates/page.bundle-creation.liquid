{% comment %}
  CUSTOM BUNDLE BUILDER - Creation Page
  Template: page.bundle-creation.liquid

  Allows customers to submit bundle proposals by entering product URLs
  - Validates only internal product URLs (alphamedical.shop/products/*)
  - Tracks identical submissions
  - Creates bundle when 10 identical proposals received
{% endcomment %}

<div class="bundle-creation-page page-width">
  <div class="bundle-creation-hero">
    <h1 class="bundle-creation-title">{{ page.title | default: "Create Your Own Bundle" }}</h1>
    <p class="bundle-creation-subtitle">
      Propose your perfect product combination! When 10 customers propose the same bundle, we'll make it real with a 15% discount.
    </p>
  </div>

  {%- comment -%} How It Works Section {%- endcomment -%}
  <section class="bundle-how-it-works">
    <h2>How It Works</h2>
    <div class="steps-grid">
      <div class="step">
        <div class="step-number">1</div>
        <h3>Propose Your Bundle</h3>
        <p>Add 2-5 product URLs from our shop</p>
      </div>
      <div class="step">
        <div class="step-number">2</div>
        <h3>Track Votes</h3>
        <p>See how many customers proposed the same combination</p>
      </div>
      <div class="step">
        <div class="step-number">3</div>
        <h3>Bundle Goes Live!</h3>
        <p>At 10 votes, we create it with 15% OFF</p>
      </div>
      <div class="step">
        <div class="step-number">4</div>
        <h3>Get Notified</h3>
        <p>All 10 proposers receive an email when bundle is live</p>
      </div>
    </div>
  </section>

  {%- comment -%} Bundle Creation Form {%- endcomment -%}
  <section class="bundle-creation-form-section">
    <div class="form-container">

      {%- comment -%} Customer Login Check {%- endcomment -%}
      {% if customer %}

        <div class="customer-status">
          <p>✅ Logged in as <strong>{{ customer.email }}</strong></p>
          <p class="submission-counter">
            <span id="submissions-remaining">Loading...</span>
          </p>
        </div>

        <form id="bundle-proposal-form" class="bundle-form" data-customer-id="{{ customer.id }}">

          <div class="form-header">
            <h2>Build Your Bundle</h2>
            <p>Enter 2-5 product URLs from our shop (alphamedical.shop/products/...)</p>
          </div>

          {%- comment -%} Product URL Inputs (Dynamic) {%- endcomment -%}
          <div id="product-urls-container" class="product-urls-container">
            <div class="product-url-input-group" data-index="1">
              <label for="product-url-1">Product #1 URL <span class="required">*</span></label>
              <input
                type="url"
                id="product-url-1"
                name="product_url_1"
                class="product-url-input"
                placeholder="https://www.alphamedical.shop/products/your-product-handle"
                required
                pattern="https?://.*alphamedical\.shop/products/[a-z0-9\-]+"
                data-index="1"
              >
              <div class="product-preview" id="preview-1"></div>
              <div class="input-error" id="error-1"></div>
            </div>

            <div class="product-url-input-group" data-index="2">
              <label for="product-url-2">Product #2 URL <span class="required">*</span></label>
              <input
                type="url"
                id="product-url-2"
                name="product_url_2"
                class="product-url-input"
                placeholder="https://www.alphamedical.shop/products/your-product-handle"
                required
                pattern="https?://.*alphamedical\.shop/products/[a-z0-9\-]+"
                data-index="2"
              >
              <div class="product-preview" id="preview-2"></div>
              <div class="input-error" id="error-2"></div>
            </div>
          </div>

          {%- comment -%} Add/Remove Product Buttons {%- endcomment -%}
          <div class="form-actions-container">
            <button
              type="button"
              id="add-product-btn"
              class="button button--secondary"
              disabled
            >
              + Add Another Product (Max 5)
            </button>
            <p class="helper-text">You can add 2-5 products to your bundle proposal</p>
          </div>

          {%- comment -%} Bundle Summary {%- endcomment -%}
          <div id="bundle-summary" class="bundle-summary" style="display: none;">
            <h3>Bundle Summary</h3>
            <div id="summary-products"></div>
            <div class="pricing-summary">
              <div class="pricing-row">
                <span>Total Regular Price:</span>
                <span id="total-price">$0.00</span>
              </div>
              <div class="pricing-row bundle-price">
                <span>Bundle Price (15% OFF):</span>
                <span id="bundle-price">$0.00</span>
              </div>
              <div class="pricing-row savings">
                <span>Your Savings:</span>
                <span id="savings">$0.00</span>
              </div>
            </div>
          </div>

          {%- comment -%} Terms & Conditions {%- endcomment -%}
          <div class="form-terms">
            <label class="checkbox-label">
              <input type="checkbox" id="terms-accept" required>
              <span>I understand that bundles are created only when 10 customers propose identical combinations. I can submit up to 3 proposals per month.</span>
            </label>
          </div>

          {%- comment -%} Submit Button {%- endcomment -%}
          <div class="form-submit">
            <button
              type="submit"
              id="submit-proposal-btn"
              class="button button--primary button--full-width"
              disabled
            >
              Submit Bundle Proposal
            </button>
            <p class="submit-note">We'll validate your products and notify you when your proposal is received</p>
          </div>

          {%- comment -%} Loading State {%- endcomment -%}
          <div id="form-loading" class="form-loading" style="display: none;">
            <div class="spinner"></div>
            <p>Validating and submitting your proposal...</p>
          </div>

          {%- comment -%} Success/Error Messages {%- endcomment -%}
          <div id="form-messages" class="form-messages"></div>

        </form>

      {% else %}

        {%- comment -%} Not Logged In - Redirect to Login {%- endcomment -%}
        <div class="login-required">
          <div class="login-icon">🔒</div>
          <h2>Login Required</h2>
          <p>You must be logged in to submit bundle proposals.</p>
          <a href="/account/login?return_url={{ page.url | url_encode }}" class="button button--primary">
            Log In to Continue
          </a>
          <p class="register-link">
            Don't have an account? <a href="/account/register?return_url={{ page.url | url_encode }}">Create one here</a>
          </p>
        </div>

      {% endif %}
    </div>
  </section>

  {%- comment -%} Trending Proposals Section {%- endcomment -%}
  <section class="trending-proposals">
    <h2>Trending Bundle Proposals</h2>
    <p>Vote for existing proposals by submitting the same product combination!</p>
    <div id="trending-proposals-list" class="proposals-grid">
      <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading trending proposals...</p>
      </div>
    </div>
  </section>

  {%- comment -%} FAQ Section {%- endcomment -%}
  <section class="bundle-faq">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-grid">
      <details class="faq-item">
        <summary>What products can I include?</summary>
        <p>You can only include products from our shop (URLs starting with alphamedical.shop/products/). External links are not accepted.</p>
      </details>
      <details class="faq-item">
        <summary>How many proposals can I submit?</summary>
        <p>You can submit up to 3 bundle proposals per month.</p>
      </details>
      <details class="faq-item">
        <summary>What happens when 10 customers propose the same bundle?</summary>
        <p>We automatically create it as a real product with a 15% discount, and all 10 proposers receive an email notification!</p>
      </details>
      <details class="faq-item">
        <summary>Can I propose the same bundle twice?</summary>
        <p>No, each customer can only propose each unique product combination once.</p>
      </details>
      <details class="faq-item">
        <summary>What if my proposal never reaches 10 votes?</summary>
        <p>You can still purchase the products individually. Share your proposal with friends to help it reach 10 votes!</p>
      </details>
      <details class="faq-item">
        <summary>What discount do bundles get?</summary>
        <p>All community-created bundles receive a 15% discount off the total price of individual products.</p>
      </details>
    </div>
  </section>

</div>

