{%- comment -%} JavaScript for Form Logic {%- endcomment -%}
<script>
// Bundle Creation Form Logic
(function() {
  'use strict';

  const SHOP_DOMAIN = 'alphamedical.shop';
  const MIN_PRODUCTS = 2;
  const MAX_PRODUCTS = 5;
  const MAX_SUBMISSIONS_PER_MONTH = 3;

  let productCount = 2;
  let validatedProducts = {};
  let customerSubmissionsThisMonth = 0;

  // DOM Elements
  const form = document.getElementById('bundle-proposal-form');
  const productUrlsContainer = document.getElementById('product-urls-container');
  const addProductBtn = document.getElementById('add-product-btn');
  const submitBtn = document.getElementById('submit-proposal-btn');
  const bundleSummary = document.getElementById('bundle-summary');
  const summaryProducts = document.getElementById('summary-products');
  const totalPriceEl = document.getElementById('total-price');
  const bundlePriceEl = document.getElementById('bundle-price');
  const savingsEl = document.getElementById('savings');
  const formLoading = document.getElementById('form-loading');
  const formMessages = document.getElementById('form-messages');
  const termsCheckbox = document.getElementById('terms-accept');
  const submissionsRemaining = document.getElementById('submissions-remaining');

  // Initialize
  if (form) {
    initializeForm();
  }

  function initializeForm() {
    // Load customer submission count
    loadCustomerSubmissionCount();

    // Add event listeners
    addProductBtn.addEventListener('click', addProductField);
    form.addEventListener('submit', handleSubmit);
    termsCheckbox.addEventListener('change', validateForm);

    // Validate existing inputs on blur
    document.querySelectorAll('.product-url-input').forEach(input => {
      input.addEventListener('blur', () => validateProductUrl(input));
      input.addEventListener('input', () => {
        clearError(input.dataset.index);
        validateForm();
      });
    });

    // Load trending proposals
    loadTrendingProposals();
  }

  function loadCustomerSubmissionCount() {
    // TODO: Call backend API to get customer's submission count for current month
    // For now, simulate with localStorage
    const currentMonth = new Date().toISOString().slice(0, 7);
    const storageKey = `bundle_submissions_${currentMonth}`;
    customerSubmissionsThisMonth = parseInt(localStorage.getItem(storageKey) || '0');

    const remaining = MAX_SUBMISSIONS_PER_MONTH - customerSubmissionsThisMonth;
    submissionsRemaining.textContent = `${remaining}/${MAX_SUBMISSIONS_PER_MONTH} proposals remaining this month`;

    if (remaining <= 0) {
      submitBtn.disabled = true;
      showMessage('You have reached your 3 proposals for this month. Next reset: ' + getNextMonthDate(), 'info');
    }
  }

  function addProductField() {
    if (productCount >= MAX_PRODUCTS) return;

    productCount++;
    const newField = createProductField(productCount);
    productUrlsContainer.insertAdjacentHTML('beforeend', newField);

    // Add event listeners to new field
    const newInput = document.getElementById(`product-url-${productCount}`);
    newInput.addEventListener('blur', () => validateProductUrl(newInput));
    newInput.addEventListener('input', () => {
      clearError(productCount);
      validateForm();
    });

    // Add remove button
    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'remove-product-btn';
    removeBtn.textContent = '× Remove';
    removeBtn.onclick = () => removeProductField(productCount);
    document.querySelector(`[data-index="${productCount}"]`).appendChild(removeBtn);

    validateForm();
  }

  function createProductField(index) {
    return `
      <div class="product-url-input-group" data-index="${index}">
        <label for="product-url-${index}">Product #${index} URL ${index <= MIN_PRODUCTS ? '<span class="required">*</span>' : ''}</label>
        <input
          type="url"
          id="product-url-${index}"
          name="product_url_${index}"
          class="product-url-input"
          placeholder="https://www.${SHOP_DOMAIN}/products/your-product-handle"
          ${index <= MIN_PRODUCTS ? 'required' : ''}
          pattern="https?://.*${SHOP_DOMAIN.replace('.', '\\.')}/products/[a-z0-9\\-]+"
          data-index="${index}"
        >
        <div class="product-preview" id="preview-${index}"></div>
        <div class="input-error" id="error-${index}"></div>
      </div>
    `;
  }

  function removeProductField(index) {
    const field = document.querySelector(`[data-index="${index}"]`);
    if (field) {
      field.remove();
      delete validatedProducts[index];
      productCount--;
      updateBundleSummary();
      validateForm();
    }
  }

  async function validateProductUrl(input) {
    const index = input.dataset.index;
    const url = input.value.trim();

    if (!url) {
      clearError(index);
      clearPreview(index);
      delete validatedProducts[index];
      return;
    }

    // Validate URL format
    if (!isValidProductUrl(url)) {
      showError(index, 'Invalid URL. Must be a product from ' + SHOP_DOMAIN);
      input.classList.add('invalid');
      input.classList.remove('valid');
      delete validatedProducts[index];
      return;
    }

    // Extract product handle
    const handle = extractProductHandle(url);
    if (!handle) {
      showError(index, 'Could not extract product handle from URL');
      input.classList.add('invalid');
      input.classList.remove('valid');
      delete validatedProducts[index];
      return;
    }

    // Check for duplicates
    if (isDuplicateProduct(handle, index)) {
      showError(index, 'This product is already in your bundle');
      input.classList.add('invalid');
      input.classList.remove('valid');
      delete validatedProducts[index];
      return;
    }

    // Fetch product data from Shopify
    try {
      const product = await fetchProductData(handle);

      if (!product) {
        showError(index, 'Product not found. Please check the URL.');
        input.classList.add('invalid');
        input.classList.remove('valid');
        delete validatedProducts[index];
        return;
      }

      // Valid product!
      clearError(index);
      input.classList.remove('invalid');
      input.classList.add('valid');

      validatedProducts[index] = product;
      showProductPreview(index, product);
      updateBundleSummary();
      validateForm();

    } catch (error) {
      console.error('Error fetching product:', error);
      showError(index, 'Error validating product. Please try again.');
      input.classList.add('invalid');
      input.classList.remove('valid');
      delete validatedProducts[index];
    }
  }

  function isValidProductUrl(url) {
    const pattern = new RegExp(`https?://(www\\.)?${SHOP_DOMAIN.replace('.', '\\.')}/products/[a-z0-9\\-]+`, 'i');
    return pattern.test(url);
  }

  function extractProductHandle(url) {
    const match = url.match(/\/products\/([a-z0-9\-]+)/i);
    return match ? match[1] : null;
  }

  function isDuplicateProduct(handle, currentIndex) {
    return Object.entries(validatedProducts).some(([index, product]) => {
      return index !== currentIndex.toString() && product.handle === handle;
    });
  }

  async function fetchProductData(handle) {
    try {
      const response = await fetch(`/products/${handle}.js`);
      if (!response.ok) return null;

      const product = await response.json();
      return {
        id: product.id,
        handle: product.handle,
        title: product.title,
        price: product.price / 100, // Convert cents to dollars
        image: product.featured_image,
        url: product.url
      };
    } catch (error) {
      console.error('Error fetching product:', error);
      return null;
    }
  }

  function showProductPreview(index, product) {
    const preview = document.getElementById(`preview-${index}`);
    preview.innerHTML = `
      <img src="${product.image}" alt="${product.title}">
      <div class="info">
        <h4>${product.title}</h4>
        <p class="price">$${product.price.toFixed(2)}</p>
      </div>
    `;
    preview.classList.add('show');
  }

  function clearPreview(index) {
    const preview = document.getElementById(`preview-${index}`);
    preview.innerHTML = '';
    preview.classList.remove('show');
  }

  function showError(index, message) {
    const errorEl = document.getElementById(`error-${index}`);
    errorEl.textContent = message;
    errorEl.classList.add('show');
  }

  function clearError(index) {
    const errorEl = document.getElementById(`error-${index}`);
    errorEl.textContent = '';
    errorEl.classList.remove('show');
  }

  function updateBundleSummary() {
    const productArray = Object.values(validatedProducts);

    if (productArray.length < MIN_PRODUCTS) {
      bundleSummary.style.display = 'none';
      return;
    }

    bundleSummary.style.display = 'block';

    // Update products list
    summaryProducts.innerHTML = productArray.map(product => `
      <div class="summary-product">
        <img src="${product.image}" alt="${product.title}">
        <div class="info">
          <h4>${product.title}</h4>
          <span class="price">$${product.price.toFixed(2)}</span>
        </div>
      </div>
    `).join('');

    // Calculate pricing
    const totalPrice = productArray.reduce((sum, p) => sum + p.price, 0);
    const bundlePrice = totalPrice * 0.85; // 15% discount
    const savings = totalPrice - bundlePrice;

    totalPriceEl.textContent = `$${totalPrice.toFixed(2)}`;
    bundlePriceEl.textContent = `$${bundlePrice.toFixed(2)}`;
    savingsEl.textContent = `$${savings.toFixed(2)}`;
  }

  function validateForm() {
    const productArray = Object.values(validatedProducts);
    const hasMinProducts = productArray.length >= MIN_PRODUCTS;
    const termsAccepted = termsCheckbox.checked;
    const hasSubmissionsLeft = customerSubmissionsThisMonth < MAX_SUBMISSIONS_PER_MONTH;

    submitBtn.disabled = !(hasMinProducts && termsAccepted && hasSubmissionsLeft);
    addProductBtn.disabled = productCount >= MAX_PRODUCTS || productArray.length < productCount;
  }

  async function handleSubmit(e) {
    e.preventDefault();

    const productArray = Object.values(validatedProducts);

    if (productArray.length < MIN_PRODUCTS) {
      showMessage(`Please add at least ${MIN_PRODUCTS} products to your bundle.`, 'error');
      return;
    }

    if (customerSubmissionsThisMonth >= MAX_SUBMISSIONS_PER_MONTH) {
      showMessage('You have reached your monthly submission limit.', 'error');
      return;
    }

    // Show loading
    formLoading.style.display = 'block';
    submitBtn.disabled = true;

    // Prepare proposal data
    const proposalData = {
      customer_id: form.dataset.customerId,
      products: productArray.map(p => ({
        id: p.id,
        handle: p.handle,
        title: p.title,
        price: p.price,
        url: p.url
      })),
      total_value: productArray.reduce((sum, p) => sum + p.price, 0),
      submitted_at: new Date().toISOString()
    };

    try {
      // TODO: Send to backend API
      // For MVP, simulate with localStorage
      await submitProposal(proposalData);

      // Update submission count
      customerSubmissionsThisMonth++;
      const currentMonth = new Date().toISOString().slice(0, 7);
      localStorage.setItem(`bundle_submissions_${currentMonth}`, customerSubmissionsThisMonth);

      // Show success
      formLoading.style.display = 'none';
      showMessage(`
        <strong>✅ Proposal Submitted Successfully!</strong><br>
        Your bundle proposal has been received. You'll be notified when it reaches 10 votes.<br>
        <a href="/pages/my-proposals">View Your Proposals</a>
      `, 'success');

      // Reset form
      form.reset();
      validatedProducts = {};
      updateBundleSummary();
      loadCustomerSubmissionCount();

    } catch (error) {
      console.error('Submission error:', error);
      formLoading.style.display = 'none';
      submitBtn.disabled = false;
      showMessage('Error submitting proposal. Please try again.', 'error');
    }
  }

  async function submitProposal(data) {
    // Simulate API call
    return new Promise((resolve) => {
      setTimeout(() => {
        console.log('Proposal submitted:', data);
        // Store in localStorage for demo
        const proposals = JSON.parse(localStorage.getItem('bundle_proposals') || '[]');
        proposals.push(data);
        localStorage.setItem('bundle_proposals', JSON.stringify(proposals));
        resolve();
      }, 1500);
    });
  }

  function showMessage(message, type) {
    formMessages.innerHTML = `<div class="message ${type}">${message}</div>`;
    formMessages.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function getNextMonthDate() {
    const now = new Date();
    const next = new Date(now.getFullYear(), now.getMonth() + 1, 1);
    return next.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  }

  async function loadTrendingProposals() {
    const container = document.getElementById('trending-proposals-list');

    // TODO: Fetch from backend API
    // For demo, use localStorage
    setTimeout(() => {
      const proposals = JSON.parse(localStorage.getItem('bundle_proposals') || '[]');

      if (proposals.length === 0) {
        container.innerHTML = '<p style="text-align: center; color: #666;">No proposals yet. Be the first to create one!</p>';
        return;
      }

      // Group by identical product combinations
      const grouped = groupIdenticalProposals(proposals);

      container.innerHTML = grouped.map((group, index) => `
        <div class="proposal-card">
          <h3>Bundle Proposal #${index + 1}</h3>
          <div class="products-list">
            ${group.products.map(p => `• ${p.title}`).join('<br>')}
          </div>
          <div class="vote-progress">
            <div class="progress-bar">
              <div class="progress-fill" style="width: ${(group.count / 10) * 100}%">
                ${group.count}/10
              </div>
            </div>
            <p class="vote-text">${10 - group.count} more votes needed!</p>
          </div>
          <button class="button button--secondary vote-btn" onclick="alert('Vote feature coming soon!')">
            Vote for This Bundle
          </button>
        </div>
      `).join('');
    }, 1000);
  }

  function groupIdenticalProposals(proposals) {
    const groups = {};

    proposals.forEach(proposal => {
      const key = proposal.products.map(p => p.id).sort().join('-');
      if (!groups[key]) {
        groups[key] = {
          products: proposal.products,
          count: 0
        };
      }
      groups[key].count++;
    });

    return Object.values(groups).sort((a, b) => b.count - a.count);
  }

})();
</script>
