<!-- /pages/our-story -->
<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <header class="page-header">
    <h1 class="page-title">{{ page.title | default: "Our Story" }}</h1>
  </header>

  <div class="our-story-content rte">
    <!-- Hero Section -->
    <div class="our-story-hero" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); padding: 60px 40px; border-radius: 16px; margin-bottom: 48px; text-align: center;">
      <h2 style="font-size: 2.5em; margin-bottom: 20px; color: #1a202c;">Building Trust Through Quality Since 2025</h2>
      <p style="font-size: 1.2em; color: #4a5568; max-width: 800px; margin: 0 auto; line-height: 1.8;">
        Alpha Medical Care is an international medical equipment retailer with a proven track record in Canada and Europe, now bringing our expertise to customers in the United States.
      </p>
    </div>

    <!-- Timeline Section -->
    <section style="margin-bottom: 60px;">
      <h2 style="font-size: 2em; margin-bottom: 30px; color: #2d3748; border-bottom: 3px solid #4770DB; padding-bottom: 10px;">Our Journey</h2>

      <div class="timeline" style="margin-left: 40px; border-left: 4px solid #4770DB; padding-left: 40px;">
        <!-- Pre-2025: Physical Stores -->
        <div class="timeline-item" style="margin-bottom: 40px; position: relative;">
          <div style="position: absolute; left: -52px; top: 0; width: 24px; height: 24px; background: #4770DB; border-radius: 50%; border: 4px solid white;"></div>
          <h3 style="font-size: 1.5em; color: #2d3748; margin-bottom: 10px;">🏪 Before 2025: Physical Retail Foundation</h3>
          <p style="color: #4a5568; line-height: 1.8; margin-bottom: 15px;">
            Alpha Medical Care established a strong presence in <strong>Canada and Europe</strong> through physical retail locations. Our stores became trusted destinations for customers seeking quality orthopedic equipment, posture correctors, pain relief devices, and medical-grade recovery tools.
          </p>
          <div style="background: #e6f2ff; padding: 20px; border-radius: 8px; border-left: 4px solid #4770DB;">
            <strong style="color: #2c5282;">Milestone:</strong> Served <strong>10,000+ customers</strong> across our Canadian and European locations, building a reputation for quality products and exceptional customer service.
          </div>
        </div>

        <!-- 2025: US E-commerce Launch -->
        <div class="timeline-item" style="margin-bottom: 40px; position: relative;">
          <div style="position: absolute; left: -52px; top: 0; width: 24px; height: 24px; background: #10b981; border-radius: 50%; border: 4px solid white;"></div>
          <h3 style="font-size: 1.5em; color: #2d3748; margin-bottom: 10px;">🚀 2025: Expansion to United States</h3>
          <p style="color: #4a5568; line-height: 1.8; margin-bottom: 15px;">
            Recognizing the demand for quality medical equipment in the United States, we launched <strong>alphamedical.shop</strong> — our dedicated e-commerce platform to serve American customers. Our US headquarters coordinates online operations while maintaining the same quality standards established in our physical stores.
          </p>
          <div style="background: #f0fdf4; padding: 20px; border-radius: 8px; border-left: 4px solid #10b981;">
            <strong style="color: #065f46;">New Chapter:</strong> Bringing international expertise to US customers with FDA-compliant products, free shipping on orders $150+, and a 30-day money-back guarantee.
          </div>
        </div>
      </div>
    </section>

    <!-- What Sets Us Apart -->
    <section style="margin-bottom: 60px;">
      <h2 style="font-size: 2em; margin-bottom: 30px; color: #2d3748; border-bottom: 3px solid #10b981; padding-bottom: 10px;">What Sets Us Apart</h2>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
        <!-- Quality -->
        <div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.07); border-top: 4px solid #4770DB;">
          <div style="font-size: 2.5em; margin-bottom: 15px;">🏆</div>
          <h3 style="font-size: 1.3em; color: #2d3748; margin-bottom: 12px;">Quality First</h3>
          <p style="color: #4a5568; line-height: 1.7;">
            Every product is <strong>FDA-compliant</strong> and sourced from certified manufacturers. We test products before they reach customers and stand behind every item with comprehensive warranty coverage.
          </p>
        </div>

        <!-- International Experience -->
        <div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.07); border-top: 4px solid #8b5cf6;">
          <div style="font-size: 2.5em; margin-bottom: 15px;">🌍</div>
          <h3 style="font-size: 1.3em; color: #2d3748; margin-bottom: 12px;">International Expertise</h3>
          <p style="color: #4a5568; line-height: 1.7;">
            With operations in <strong>Canada, Europe, and the United States</strong>, we understand diverse customer needs and comply with international medical device standards.
          </p>
        </div>

        <!-- Customer-Centric -->
        <div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.07); border-top: 4px solid #f59e0b;">
          <div style="font-size: 2.5em; margin-bottom: 15px;">🤝</div>
          <h3 style="font-size: 1.3em; color: #2d3748; margin-bottom: 12px;">Customer-Centric</h3>
          <p style="color: #4a5568; line-height: 1.7;">
            <strong>30-day money-back guarantee</strong>, responsive customer support, and free shipping on orders over $150. Your satisfaction is our priority.
          </p>
        </div>
      </div>
    </section>

    <!-- Product Philosophy -->
    <section style="margin-bottom: 60px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 50px 40px; border-radius: 16px; color: white; text-align: center;">
      <h2 style="font-size: 2em; margin-bottom: 20px; color: white;">Our Product Philosophy</h2>
      <p style="font-size: 1.1em; line-height: 1.8; max-width: 900px; margin: 0 auto 30px; opacity: 0.95;">
        We specialize in <strong>orthopedic equipment and pain relief devices</strong> that make a real difference in people's lives. From posture correctors to knee braces, cervical traction devices to LED therapy tools — every product is selected based on effectiveness, safety, and customer feedback.
      </p>
      <div style="background: rgba(255,255,255,0.15); padding: 25px; border-radius: 12px; backdrop-filter: blur(10px); max-width: 700px; margin: 0 auto;">
        <p style="font-size: 1.05em; margin: 0; font-weight: 500;">
          💡 <em>"Professional-grade orthopedic solutions accessible to everyone"</em>
        </p>
      </div>
    </section>

    <!-- Transparency & Trust -->
    <section style="margin-bottom: 60px;">
      <h2 style="font-size: 2em; margin-bottom: 30px; color: #2d3748; border-bottom: 3px solid #ef4444; padding-bottom: 10px;">Transparency & Trust</h2>

      <div style="background: #fef2f2; padding: 40px; border-radius: 12px; border-left: 6px solid #ef4444;">
        <h3 style="font-size: 1.4em; color: #991b1b; margin-bottom: 20px;">Important Clarifications</h3>

        <div style="margin-bottom: 25px;">
          <h4 style="font-size: 1.1em; color: #7f1d1d; margin-bottom: 10px;">🔍 Not Affiliated With:</h4>
          <ul style="color: #4a5568; line-height: 2;">
            <li><strong>Hello Alpha</strong> (telemedicine platform) — We sell medical equipment, not telehealth services</li>
            <li><strong>AlphaMedicalStore.com</strong> (fraudulent pharmacy) — We are NOT a pharmacy and do NOT sell prescription drugs</li>
          </ul>
        </div>

        <div style="margin-bottom: 25px;">
          <h4 style="font-size: 1.1em; color: #7f1d1d; margin-bottom: 10px;">📊 About Our "10,000+ Customers Worldwide":</h4>
          <p style="color: #4a5568; line-height: 1.8; margin-bottom: 10px;">
            This number represents customers served across <strong>all our channels</strong>:
          </p>
          <ul style="color: #4a5568; line-height: 2;">
            <li><strong>Physical stores</strong> in Canada and Europe (majority of our 10,000+ customers)</li>
            <li><strong>E-commerce platform</strong> alphamedical.shop (growing US customer base since 2025)</li>
          </ul>
          <p style="color: #4a5568; line-height: 1.8; margin-top: 15px;">
            <em>We believe in honest marketing. Our online store is new, but our company experience is real.</em>
          </p>
        </div>

        <div>
          <h4 style="font-size: 1.1em; color: #7f1d1d; margin-bottom: 10px;">✅ Our Commitment:</h4>
          <p style="color: #4a5568; line-height: 1.8;">
            We are committed to <strong>complete transparency</strong> about our business structure, product sourcing, and customer claims. If you have questions about our operations, contact us at <a href="mailto:support@alphamedical.shop" style="color: #4770DB; text-decoration: underline;">support@alphamedical.shop</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact CTA -->
    <section style="text-align: center; padding: 50px 30px; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); border-radius: 16px; color: white;">
      <h2 style="font-size: 2.2em; margin-bottom: 20px; color: white;">Have Questions?</h2>
      <p style="font-size: 1.1em; margin-bottom: 30px; opacity: 0.95;">
        We're here to help! Contact our customer support team for product advice, order assistance, or general inquiries.
      </p>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 20px;">
        <a href="mailto:support@alphamedical.shop" style="display: inline-block; background: white; color: #f5576c; padding: 15px 35px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 1.05em; box-shadow: 0 4px 6px rgba(0,0,0,0.1); transition: transform 0.2s;">
          📧 Email Us
        </a>
        <a href="/pages/faq" style="display: inline-block; background: rgba(255,255,255,0.2); color: white; padding: 15px 35px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 1.05em; backdrop-filter: blur(10px); border: 2px solid white; transition: transform 0.2s;">
          💬 View FAQs
        </a>
      </div>
    </section>
  </div>
</div>

<style>
  .our-story-content {
    font-size: 16px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .our-story-content h2 {
    margin-top: 0;
  }

  .our-story-hero h2 {
    animation: fadeInUp 0.8s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .timeline-item {
    animation: slideInLeft 0.6s ease-out backwards;
  }

  .timeline-item:nth-child(1) { animation-delay: 0.1s; }
  .timeline-item:nth-child(2) { animation-delay: 0.3s; }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media screen and (max-width: 749px) {
    .our-story-hero {
      padding: 40px 20px !important;
    }

    .our-story-hero h2 {
      font-size: 1.8em !important;
    }

    .timeline {
      margin-left: 20px !important;
      padding-left: 25px !important;
    }

    .timeline-item div[style*="position: absolute"] {
      left: -38px !important;
    }

    section[style*="padding: 50px"] {
      padding: 30px 20px !important;
    }
  }
</style>
