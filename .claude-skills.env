# ============================================================================
TEST_DEBUG="claude --debug"
TEST_LIST_PERSONAL="ls -la ~/.claude/skills/"
TEST_LIST_PROJECT="ls -la .claude/skills/"
TEST_FIND_SKILLS='find .claude/skills -name "SKILL.md"'

