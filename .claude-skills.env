# ============================================================================
# MARKETPLACE OFFICIEL
# ============================================================================
MARKETPLACE_ANTHROPIC="https://github.com/anthropics/skills"
MARKETPLACE_COMMUNITY="https://skillsmp.com"
MARKETPLACE_TOTAL_SKILLS="20115+"

# Installation commands
INSTALL_MARKETPLACE="/plugin marketplace add anthropics/skills"
INSTALL_DOCUMENTS="/plugin install document-skills"
INSTALL_EXAMPLES="/plugin install example-skills"

# ============================================================================
# SHOPIFY E-COMMERCE SKILLS
# ============================================================================

# ClaudeKit Shopify Skill (Development)
SHOPIFY_DEV_REPO="https://github.com/mrgoonie/claudekit-skills"
SHOPIFY_DEV_FEATURES="GraphQL,REST,Checkout,Liquid,Functions"
SHOPIFY_DEV_INSTALL="git clone repo → cp .claude/skills/shopify"

# Shopify MCP Server (Read-Only Data)
SHOPIFY_MCP_REPO="https://github.com/abhi-mahule/shopify-mcp-server"
SHOPIFY_MCP_PYTHON="3.10+"
SHOPIFY_MCP_DEPS="shopifyapi,fastmcp,python-dotenv"
SHOPIFY_MCP_TOOLS="get_products,get_customers,get_orders,search_products"
SHOPIFY_MCP_SAFE="true # read-only"

# AgenticFlow (2500+ integrations)
AGENTICFLOW_REPO="https://github.com/PixelML/agenticflow-skill"
AGENTICFLOW_USE="CRM_sync,Slack_notifications,order_tracking"

# Automation Toolkit (Collections)
SHOPIFY_TOOLKIT_REPO="https://github.com/IncomeStreamSurfer/shopify_automation_toolkit"
SHOPIFY_TOOLKIT_USE="collections,product_tagging"

