# ============================================================================
# QUICK START INSTALLATION
# ============================================================================

# Step 1: Create directory
CMD_1="mkdir -p .claude/skills"

# Step 2: Add marketplace
CMD_2="/plugin marketplace add anthropics/skills"

# Step 3: Install official skills
CMD_3="/plugin install document-skills"

# Step 4: Verify
CMD_4="/plugin marketplace list"

# Step 5: Test activation
CMD_5='Ask: "Create ad copy following brand guidelines"'

# ============================================================================
# CUSTOM SKILL STRUCTURE
# ============================================================================

# Minimum required
SKILL_REQUIRED_FILE="SKILL.md"
SKILL_YAML_NAME="required"
SKILL_YAML_DESC="required_max_1024_chars"

# Locations
SKILL_PATH_PERSONAL="~/.claude/skills/"
SKILL_PATH_PROJECT=".claude/skills/"

# Example structure
SKILL_STRUCTURE="my-skill/SKILL.md (YAML frontmatter + instructions)"

# ============================================================================
# SHOPIFY MCP SERVER SETUP (OPTIONAL)
# ============================================================================

# Installation
MCP_1="git clone https://github.com/abhi-mahule/shopify-mcp-server.git"
MCP_2="cd shopify-mcp-server"
MCP_3="python3 -m venv venv"
MCP_4="source venv/bin/activate"
MCP_5="pip install shopifyapi fastmcp python-dotenv"

# Configuration (.env)
MCP_STORE_URL="https://azffej-as.myshopify.com"
MCP_ACCESS_TOKEN="REQUIRES_SHOPIFY_ADMIN_API_TOKEN"

# Test
MCP_6="python test_connection.py"
MCP_7="chmod +x server.py"

# ============================================================================
