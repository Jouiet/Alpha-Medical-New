LESSON_1_TITLE="Always Clarify Strategic Context"
LESSON_1_POINT_1="Technical Feasibility ≠ Strategic Priority"
LESSON_1_POINT_2="Ask WHY before recommending WHAT"
LESSON_1_POINT_3="User's business goals override technical optimization"
LESSON_1_EXAMPLE="YouTube = lead gen channel, not just content distribution"

LESSON_2_TITLE="Workflow Scope Clarity"
LESSON_2_POINT_1="YouTube workflow ambiguity (production vs upload)"
LESSON_2_POINT_2="Always define exact workflow boundaries"
LESSON_2_POINT_3="Distinguish: Content creation vs content distribution"
LESSON_2_EXAMPLE="Workflow #2 = upload/metadata, NOT video production"

LESSON_3_TITLE="Documentation Discipline"
LESSON_3_POINT_1="Default Action: UPDATE existing, not CREATE new"
LESSON_3_POINT_2="Comprehensive ≠ verbose (append, don't duplicate)"
LESSON_3_POINT_3="User preference: Concise updates over exhaustive analysis"
LESSON_3_PRINCIPLE="Every new file must be absolutely necessary"

LESSON_4_TITLE="Verification Rigor"
LESSON_4_POINT_1="API Verification > Config File Labels"
LESSON_4_POINT_2="When in doubt, verify via source of truth (API, not local .env)"
LESSON_4_POINT_3="Factual corrections DURING session = good practice"
LESSON_4_EXAMPLE="INPUT/OUTPUT folder IDs swap detected and corrected"

