{% comment %}
  Loyalty Transaction History
  Displays chronological list of all loyalty point transactions
{% endcomment %}

{%- liquid
  assign customer_history = '[]'

  if customer
    assign history_metafield = customer.metafields.loyalty.history

    if history_metafield != blank
      assign customer_history = history_metafield
    endif
  endif
-%}

<div class="loyalty-history">
  <h3 class="history-title">Transaction History</h3>

  {% if customer_history != '[]' and customer_history != blank %}
    <div class="history-list" data-history="{{ customer_history | escape }}">
      {%- comment -%} Transactions will be rendered by JavaScript {%- endcomment -%}
      <div class="history-loading">Loading transactions...</div>
    </div>
  {% else %}
    <div class="history-empty">
      <div class="empty-icon">📊</div>
      <p class="empty-message">No transactions yet.</p>
      <p class="empty-subtext">Start earning points by making purchases!</p>
    </div>
  {% endif %}
</div>

<style>
  /* Loyalty History Styles */
  .loyalty-history {
    margin: 24px 0;
    padding: 24px;
    background: linear-gradient(135deg, #ffffff 0%, #eff0f5 100%);
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .history-title {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 20px;
    color: #212529;
  }

  .history-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .history-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    background: #fff;
    border-radius: 8px;
    border-left: 4px solid #4770db;
    transition: all 0.2s;
  }

  .history-item:hover {
    transform: translateX(4px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .history-item.redemption {
    border-left-color: #dc3545;
  }

  .history-item.signup_bonus {
    border-left-color: #FFD700;
  }

  .history-item.purchase {
    border-left-color: #4770db;
  }

  .history-item.review {
    border-left-color: #4770db;
  }

  .history-info {
    flex: 1;
  }

  .history-action {
    font-size: 14px;
    font-weight: 600;
    color: #212529;
    margin-bottom: 4px;
  }

  .history-date {
    font-size: 12px;
    color: #6c757d;
  }

  .history-metadata {
    font-size: 12px;
    color: #495057;
    margin-top: 4px;
  }

  .history-points {
    font-size: 18px;
    font-weight: 700;
    text-align: right;
  }

  .history-points.positive {
    color: #28a745;
  }

  .history-points.negative {
    color: #dc3545;
  }

  .history-balance {
    font-size: 11px;
    color: #6c757d;
    margin-top: 2px;
  }

  /* Empty State */
  .history-empty {
    text-align: center;
    padding: 40px 20px;
  }

  .empty-icon {
    font-size: 48px;
    margin-bottom: 16px;
  }

  .empty-message {
    font-size: 16px;
    color: #495057;
    margin-bottom: 8px;
  }

  .empty-subtext {
    font-size: 14px;
    color: #6c757d;
  }

  .history-loading {
    text-align: center;
    padding: 20px;
    color: #6c757d;
  }

  /* Mobile */
  @media (max-width: 749px) {
    .history-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .history-points {
      align-self: flex-end;
    }
  }
</style>

<script>
  // Render transaction history
  document.addEventListener('DOMContentLoaded', function() {
    const historyList = document.querySelector('.history-list');
    if (!historyList) return;

    const historyData = historyList.dataset.history;
    if (!historyData) return;

    try {
      const transactions = JSON.parse(historyData);

      // Sort by date (most recent first)
      transactions.sort((a, b) => new Date(b.date) - new Date(a.date));

      // Clear loading message
      historyList.innerHTML = '';

      // Render each transaction
      transactions.forEach(transaction => {
        const item = document.createElement('div');
        item.className = `history-item ${transaction.action}`;

        const isNegative = transaction.points < 0;
        const pointsValue = Math.abs(transaction.points);
        const pointsClass = isNegative ? 'negative' : 'positive';
        const pointsSign = isNegative ? '-' : '+';

        // Format date
        const date = new Date(transaction.date);
        const formattedDate = date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });

        // Action label
        let actionLabel = transaction.action.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());

        // Metadata
        let metadata = '';
        if (transaction.order_id) {
          metadata += `<div class="history-metadata">Order: ${transaction.order_id}`;
          if (transaction.order_total) {
            metadata += ` ($${transaction.order_total})`;
          }
          metadata += `</div>`;
        }
        if (transaction.discount_code) {
          metadata += `<div class="history-metadata">Code: ${transaction.discount_code} ($${transaction.discount_value} OFF)</div>`;
        }
        if (transaction.product_id) {
          metadata += `<div class="history-metadata">Product review</div>`;
        }

        item.innerHTML = `
          <div class="history-info">
            <div class="history-action">${actionLabel}</div>
            <div class="history-date">${formattedDate}</div>
            ${metadata}
          </div>
          <div class="history-points ${pointsClass}">
            ${pointsSign}${pointsValue} pts
            <div class="history-balance">Balance: ${transaction.balance_after}</div>
          </div>
        `;

        historyList.appendChild(item);
      });

    } catch (error) {
      console.error('Error parsing transaction history:', error);
      historyList.innerHTML = '<div class="history-loading">Error loading transactions</div>';
    }
  });
</script>
