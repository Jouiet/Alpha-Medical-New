{% comment %}
  Loyalty Points Badge - Compact version for Cart Drawer
  Shows points, tier, and CTA to view full rewards
{% endcomment %}

{%- liquid
  assign customer_points = 0
  assign customer_tier = 'bronze'
  assign next_tier_points = 500

  if customer
    assign total_spent = customer.total_spent | divided_by: 100
    assign customer_points = total_spent | floor

    if customer_points >= 1501
      assign customer_tier = 'gold'
      assign next_tier_points = 0
    elsif customer_points >= 501
      assign customer_tier = 'silver'
      assign next_tier_points = 1501
    else
      assign customer_tier = 'bronze'
      assign next_tier_points = 501
    endif

    assign rewards_available = customer_points | divided_by: 100
  endif
-%}

<div class="loyalty-badge-compact" data-tier="{{ customer_tier }}">
  {% if customer %}
    {%- comment -%} Logged in - Show compact dashboard {%- endcomment -%}

    <div class="loyalty-compact-header">
      <div class="tier-badge-small {{ customer_tier }}">
        {% case customer_tier %}
          {% when 'gold' %}🥇
          {% when 'silver' %}🥈
          {% else %}🥉
        {% endcase %}
        {{ customer_tier | upcase }}
      </div>
      <div class="points-compact">
        <span class="points-num">{{ customer_points }}</span> pts
      </div>
    </div>

    {%- comment -%} Mini progress to next tier {%- endcomment -%}
    {% if next_tier_points > 0 %}
      {%- assign tier_progress = customer_points | times: 100 | divided_by: next_tier_points -%}
      <div class="tier-mini-bar">
        <div class="tier-mini-fill {{ customer_tier }}" style="width: {{ tier_progress }}%"></div>
      </div>
      <div class="next-tier-label">
        {% if customer_tier == 'bronze' %}
          {{ next_tier_points | minus: customer_points }} pts to Silver
        {% elsif customer_tier == 'silver' %}
          {{ next_tier_points | minus: customer_points }} pts to Gold
        {% endif %}
      </div>
    {% else %}
      <div class="tier-maxed-compact">🎉 Max tier!</div>
    {% endif %}

    {%- comment -%} Rewards CTA {%- endcomment -%}
    {% if rewards_available > 0 %}
      <a href="/account" class="rewards-cta-compact">
        🎁 {{ rewards_available }} reward{% if rewards_available > 1 %}s{% endif %} available!
      </a>
    {% else %}
      <a href="/account" class="rewards-cta-compact secondary">
        View Rewards
      </a>
    {% endif %}

  {% else %}
    {%- comment -%} Not logged in - CTA {%- endcomment -%}

    <div class="loyalty-compact-cta">
      <div class="cta-icon-small">🌟</div>
      <div class="cta-text">
        <strong>Join Rewards!</strong><br>
        <span class="cta-subtext">Earn 1pt per $1 spent</span>
      </div>
      <a href="/account/login" class="btn-join-compact">Join</a>
    </div>
  {% endif %}
</div>

<style>
  /* Compact Loyalty Badge for Cart Drawer */
  .loyalty-badge-compact {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    border-radius: 12px;
    padding: 12px;
    margin: 12px 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  /* Compact Header */
  .loyalty-compact-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .tier-badge-small {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 16px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .tier-badge-small.bronze {
    background: linear-gradient(135deg, #CD7F32, #B87333);
    color: #fff;
  }

  .tier-badge-small.silver {
    background: linear-gradient(135deg, #C0C0C0, #A8A8A8);
    color: #fff;
  }

  .tier-badge-small.gold {
    background: linear-gradient(135deg, #FFD700, #FFA500);
    color: #fff;
  }

  .points-compact {
    font-size: 12px;
    color: #495057;
  }

  .points-num {
    font-size: 18px;
    font-weight: 700;
    color: #4A90E2;
  }

  /* Mini Progress Bar */
  .tier-mini-bar {
    height: 6px;
    background: #dee2e6;
    border-radius: 3px;
    overflow: hidden;
    margin: 8px 0 4px;
  }

  .tier-mini-fill {
    height: 100%;
    border-radius: 3px;
    transition: width 0.4s ease-out;
  }

  .tier-mini-fill.bronze {
    background: linear-gradient(90deg, #CD7F32, #B87333);
  }

  .tier-mini-fill.silver {
    background: linear-gradient(90deg, #C0C0C0, #A8A8A8);
  }

  .tier-mini-fill.gold {
    background: linear-gradient(90deg, #FFD700, #FFA500);
  }

  .next-tier-label {
    font-size: 10px;
    color: #6c757d;
    text-align: center;
    margin-bottom: 8px;
  }

  .tier-maxed-compact {
    font-size: 11px;
    color: #28a745;
    font-weight: 600;
    text-align: center;
    margin: 8px 0;
  }

  /* Rewards CTA */
  .rewards-cta-compact {
    display: block;
    text-align: center;
    padding: 8px 12px;
    background: linear-gradient(135deg, #4A90E2, #7FCCC9);
    color: #fff;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s;
  }

  .rewards-cta-compact:hover {
    transform: translateY(-1px);
  }

  .rewards-cta-compact.secondary {
    background: #fff;
    color: #4A90E2;
    border: 2px solid #4A90E2;
  }

  /* Not Logged In CTA */
  .loyalty-compact-cta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cta-icon-small {
    font-size: 28px;
    flex-shrink: 0;
  }

  .cta-text {
    flex: 1;
    font-size: 12px;
    line-height: 1.3;
  }

  .cta-text strong {
    color: #212529;
    font-size: 13px;
  }

  .cta-subtext {
    color: #6c757d;
    font-size: 11px;
  }

  .btn-join-compact {
    padding: 8px 16px;
    background: linear-gradient(135deg, #4A90E2, #7FCCC9);
    color: #fff;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.2s;
  }

  .btn-join-compact:hover {
    transform: scale(1.05);
  }

  /* Cart Drawer Specific */
  .drawer .loyalty-badge-compact {
    margin: 12px 16px;
  }

  /* Animation */
  .loyalty-badge-compact {
    animation: slideIn 0.4s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
