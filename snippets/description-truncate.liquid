{%- comment -%}
  Description Truncate - Click to Expand
  Alpha Medical - Session 98 - Modern 2025 Design

  Usage:
  {% render 'description-truncate',
    content: product.description,
    max_lines: 5,
    class: 'product__description rte',
    label_more: 'Voir plus',
    label_less: 'Voir moins'
  %}
{%- endcomment -%}

{%- liquid
  assign max_lines = max_lines | default: 5
  assign label_more = label_more | default: 'Voir plus'
  assign label_less = label_less | default: 'Voir moins'
  assign truncate_id = id | default: 'desc-' | append: 'now' | date: '%N'
-%}

{%- if content != blank -%}
  <description-truncate
    class="description-truncate"
    data-label-more="{{ label_more }}"
    data-label-less="{{ label_less }}"
    style="--truncate-lines: {{ max_lines }};"
  >
    <div class="description-truncate__content {{ class }}" id="{{ truncate_id }}">
      {{ content }}
    </div>

    {%- comment -%} Gradient fade overlay {%- endcomment -%}
    <div class="description-truncate__fade" aria-hidden="true"></div>

    <button
      type="button"
      class="description-truncate__toggle"
      aria-expanded="false"
      aria-controls="{{ truncate_id }}"
    >
      <span class="description-truncate__label">{{ label_more }}</span>
      <span class="description-truncate__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </span>
    </button>
  </description-truncate>
{%- endif -%}
