{%- comment -%}
  Description Truncate - Click to Expand
  Alpha Medical - Session 98

  Usage:
  {% render 'description-truncate',
    content: product.description,
    max_lines: 5,
    class: 'product__description rte',
    label_more: 'Voir plus',
    label_less: 'Voir moins'
  %}

  Parameters:
  - content: (required) The HTML content to truncate
  - max_lines: (optional) Number of lines to show, default 5
  - class: (optional) Additional CSS classes for the content wrapper
  - label_more: (optional) Text for expand button, default 'Voir plus'
  - label_less: (optional) Text for collapse button, default 'Voir moins'
  - id: (optional) Unique ID for the component
{%- endcomment -%}

{%- liquid
  assign max_lines = max_lines | default: 5
  assign label_more = label_more | default: 'Voir plus'
  assign label_less = label_less | default: 'Voir moins'
  assign truncate_id = id | default: 'desc-truncate-' | append: 'now' | date: '%N'
-%}

{%- if content != blank -%}
  <description-truncate
    class="description-truncate"
    data-max-lines="{{ max_lines }}"
    data-label-more="{{ label_more }}"
    data-label-less="{{ label_less }}"
  >
    <div class="description-truncate__content is-collapsed {{ class }}" id="{{ truncate_id }}">
      {{ content }}
    </div>

    <button
      type="button"
      class="description-truncate__toggle"
      aria-expanded="false"
      aria-controls="{{ truncate_id }}"
    >
      <span class="description-truncate__label">{{ label_more }}</span>
      <span class="description-truncate__arrow" aria-hidden="true"></span>
    </button>
  </description-truncate>
{%- endif -%}
