{%- comment -%}
  Recently Viewed - Seed with diverse products
  Pre-populates localStorage with 4 diverse products for new visitors
  Usage: {% render 'recently-viewed-seed' %}
{%- endcomment -%}

<script>
(function() {
  'use strict';

  // Seed products - 4 diverse categories for wider lead targeting
  const SEED_PRODUCTS = [
    {
      id: '7602188550221',
      url: '/products/smart-electric-vacuum-cupping-device-body-scraping-massager-heating-suction-cup-device-physical-fatigue-relief-health-care',
      title: 'Smart Electric Vacuum Cupping Device Body Scraping Massager Heating Suction Cup Device Physical Fatigue Relief Health Care',
      image: 'https://cdn.shopify.com/s/files/1/0671/0316/2445/files/Sace3b4ec7b3f40d7aba829c8d9fe41ccS.webp?v=1761851126&width=300',
      price: '$61.89',
      timestamp: Date.now() - 86400000 // 1 day ago
    },
    {
      id: '7602148245581',
      url: '/products/adjustable-cervical-collar-spine-thoracic-orthosis-head-chest-neck-fixed-brace-posture-corrector-support',
      title: 'Adjustable Cervical Collar Spine Thoracic Orthosis Head Chest Neck Fixed Brace Posture Corrector Support',
      image: 'https://cdn.shopify.com/s/files/1/0671/0316/2445/files/S690054a199a943a7ac8a60c3388cb42cM.webp?v=1761845411&width=300',
      price: '$99.83',
      timestamp: Date.now() - 172800000 // 2 days ago
    },
    {
      id: '7597488038989',
      url: '/products/rehabilitation-robot-gloves-mirror-training-device',
      title: 'Rehabilitation Robot Gloves | Mirror Training Device',
      image: 'https://cdn.shopify.com/s/files/1/0671/0316/2445/files/Sdbffc851f50a44ffbe3d951a502cc813n_4432c2fb-ac68-41e1-972d-fc4223432f49.webp?v=1760382520&width=300',
      price: '$70.05',
      timestamp: Date.now() - 259200000 // 3 days ago
    },
    {
      id: '7597489840205',
      url: '/products/hello-face-red-light-therapy-mask-face-neck-infrared-led',
      title: 'Hello Face Red Light Therapy Mask | Face & Neck Infrared LED',
      image: 'https://cdn.shopify.com/s/files/1/0671/0316/2445/files/Sd0a04516f7a345b18bf6103834492136I.webp?v=1760382503&width=300',
      price: '$106.71',
      timestamp: Date.now() - 345600000 // 4 days ago
    }
  ];

  const STORAGE_KEY = 'alpha_recently_viewed';

  // Run IMMEDIATELY (not on DOMContentLoaded) to ensure localStorage is seeded
  // before render() is called
  try {
    // Check if localStorage is available
    if (typeof localStorage === 'undefined') {
      console.log('[RecentlyViewed Seed] localStorage not available');
      return;
    }

    const existing = localStorage.getItem(STORAGE_KEY);
    let items = existing ? JSON.parse(existing) : [];

    // Replace with 4 diverse products if empty or incomplete
    if (items.length < 4) {
      console.log('[RecentlyViewed Seed] Replacing with 4 diverse products for wider lead targeting');

      // REPLACE entirely with seed products (not merge)
      items = SEED_PRODUCTS;

      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      console.log('[RecentlyViewed Seed] Seeded successfully - 4 diverse products:',
        'Massage/Therapy, Neck/Posture, Hand/Recovery, Beauty/Anti-aging');
    } else {
      console.log('[RecentlyViewed Seed] Already has', items.length, 'products - no seeding needed');
    }
  } catch (error) {
    console.error('[RecentlyViewed Seed] Error:', error);
  }
})();
</script>
