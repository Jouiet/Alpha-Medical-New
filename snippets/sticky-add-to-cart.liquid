{% comment %}
  STICKY ADD TO CART WIDGET
  Displays a fixed add-to-cart bar at the bottom of the screen when the main add-to-cart button is out of view

  Usage:
    {% render 'sticky-add-to-cart', product: product %}

  Features:
    - Appears when main add-to-cart scrolls out of viewport
    - Shows product image, title, price, variant selector, quantity, add to cart
    - Fully functional (adds to cart like main button)
    - Responsive design (mobile + desktop)
    - Alpha Medical branding
    - GA4 event tracking
    - Animation: slide up from bottom

  Dependencies:
    - product object (required)
    - Theme's cart functionality (Dawn/OS 2.0)
{% endcomment %}

{%- if product -%}
  <div
    class="sticky-atc"
    id="sticky-add-to-cart-{{ product.id }}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
  >
    <div class="sticky-atc__container">

      <!-- Top Row: Image + Info -->
      <div class="sticky-atc__top-row">
        <div class="sticky-atc__image">
          {%- if product.featured_media -%}
            <img
              src="{{ product.featured_media | image_url: width: 60 }}"
              alt="{{ product.featured_media.alt | escape }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="sticky-atc__image-placeholder">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          {%- endif -%}
        </div>

        <div class="sticky-atc__info">
          <h3 class="sticky-atc__title">{{ product.title }}</h3>
          <div class="sticky-atc__price" data-sticky-price>
            {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
              <span class="sticky-atc__price-compare">
                {{ product.selected_or_first_available_variant.compare_at_price | money }}
              </span>
              <span class="sticky-atc__price-current">
                {{ product.selected_or_first_available_variant.price | money }}
              </span>
              <span class="sticky-atc__price-badge">
                {%- assign discount_percent = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | times: 100.0 | divided_by: product.selected_or_first_available_variant.compare_at_price | round -%}
                -{{ discount_percent }}%
              </span>
            {%- else -%}
              <span class="sticky-atc__price-current">
                {{ product.selected_or_first_available_variant.price | money }}
              </span>
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- Variant Selector (if multiple variants) -->
      {%- if product.has_only_default_variant == false -%}
        <select
          name="id"
          id="sticky-variant-select-{{ product.id }}"
          class="sticky-atc__variant-select"
          data-sticky-variant-select
        >
          {%- for variant in product.variants -%}
            <option
              value="{{ variant.id }}"
              {%- if variant == product.selected_or_first_available_variant -%} selected {%- endif -%}
              {%- unless variant.available -%} disabled {%- endunless -%}
              data-price="{{ variant.price }}"
              data-compare-price="{{ variant.compare_at_price }}"
            >
              {{ variant.title }}
              {%- unless variant.available -%} - Sold Out{%- endunless -%}
            </option>
          {%- endfor -%}
        </select>
      {%- endif -%}

      <!-- Bottom Row: Quantity + Add to Cart -->
      <div class="sticky-atc__actions">
        <div class="sticky-atc__quantity">
          <button
            type="button"
            class="sticky-atc__qty-btn sticky-atc__qty-minus"
            data-qty-change="-1"
            aria-label="Decrease quantity"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
          </button>
          <input
            type="number"
            name="quantity"
            id="sticky-qty-{{ product.id }}"
            class="sticky-atc__qty-input"
            value="1"
            min="1"
            data-sticky-quantity
            aria-label="Quantity"
          >
          <button
            type="button"
            class="sticky-atc__qty-btn sticky-atc__qty-plus"
            data-qty-change="1"
            aria-label="Increase quantity"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
          </button>
        </div>

        <button
          type="button"
          class="sticky-atc__button"
          id="sticky-atc-button-{{ product.id }}"
          data-sticky-add-to-cart
          {%- unless product.selected_or_first_available_variant.available -%}
            disabled
          {%- endunless -%}
        >
          <svg class="sticky-atc__button-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span class="sticky-atc__button-text" data-sticky-button-text>
            {%- if product.selected_or_first_available_variant.available -%}
              Add to Cart
            {%- else -%}
              Sold Out
            {%- endif -%}
          </span>
          <span class="sticky-atc__button-loader" style="display: none;">
            <svg class="sticky-atc__spinner" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
            </svg>
          </span>
        </button>
      </div>

    </div>
  </div>

  <style>
  .sticky-atc {
    position: fixed;
    top: 120px;
    right: 20px;
    background: white;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    z-index: 1000;
    transform: translateX(120%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 14px 19px;
    border-left: 4px solid transparent;
    border-image: linear-gradient(135deg, #0e1b4d 0%, #4770db 100%);
    border-image-slice: 1;
    border-radius: 12px;
    max-width: 263px;
    width: auto;
  }

  .sticky-atc.is-visible {
    transform: translateX(0);
  }

  .sticky-atc__container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
  }

  .sticky-atc__top-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sticky-atc__image {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid #e0e0e0;
    background: #f9f9f9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sticky-atc__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sticky-atc__image-placeholder {
    color: #ccc;
  }

  .sticky-atc__info {
    flex: 1;
    min-width: 0;
  }

  .sticky-atc__title {
    font-size: 13px;
    font-weight: 600;
    color: #0e1b4d;
    margin: 0 0 3px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sticky-atc__price {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .sticky-atc__price-compare {
    font-size: 11px;
    color: #999;
    text-decoration: line-through;
  }

  .sticky-atc__price-current {
    font-size: 17px;
    font-weight: 700;
    color: #4770db;
  }

  .sticky-atc__price-badge {
    display: inline-block;
    background: #e32402;
    color: white;
    padding: 2px 5px;
    border-radius: 3px;
    font-size: 10px;
    font-weight: 600;
  }

  .sticky-atc__variant-select {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    font-size: 13px;
    color: #0e1b4d;
    background: white;
    cursor: pointer;
    transition: border-color 0.3s ease;
  }

  .sticky-atc__variant-select:hover,
  .sticky-atc__variant-select:focus {
    border-color: #4770db;
    outline: none;
  }

  .sticky-atc__actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .sticky-atc__quantity {
    display: flex;
    align-items: center;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .sticky-atc__qty-btn {
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    border: none;
    cursor: pointer;
    color: #4770db;
    transition: all 0.2s ease;
  }

  .sticky-atc__qty-btn:hover {
    background: rgba(71, 112, 219, 0.1);
  }

  .sticky-atc__qty-btn:active {
    transform: scale(0.95);
  }

  .sticky-atc__qty-input {
    width: 32px;
    height: 26px;
    border: none;
    border-left: 1px solid #e0e0e0;
    border-right: 1px solid #e0e0e0;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    color: #0e1b4d;
    -moz-appearance: textfield;
  }

  .sticky-atc__qty-input::-webkit-outer-spin-button,
  .sticky-atc__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .sticky-atc__button {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 12px;
    background: linear-gradient(135deg, #0e1b4d 0%, #4770db 100%);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    flex: 1.5;
    min-width: 0;
  }

  .sticky-atc__button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(71, 112, 219, 0.4);
  }

  .sticky-atc__button:active:not(:disabled) {
    transform: translateY(0);
  }

  .sticky-atc__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: #ccc;
  }

  .sticky-atc__button-icon {
    flex-shrink: 0;
  }

  .sticky-atc__button-loader {
    display: none;
  }

  .sticky-atc__button.is-loading .sticky-atc__button-text,
  .sticky-atc__button.is-loading .sticky-atc__button-icon {
    display: none;
  }

  .sticky-atc__button.is-loading .sticky-atc__button-loader {
    display: block;
  }

  .sticky-atc__spinner {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .sticky-atc {
      padding: 12px 14px;
      top: 80px;
      right: 10px;
      max-width: 236px;
    }

    .sticky-atc__container {
      gap: 10px;
      padding: 0;
    }

    .sticky-atc__image {
      width: 55px;
      height: 55px;
    }

    .sticky-atc__title {
      font-size: 14px;
    }

    .sticky-atc__price-current {
      font-size: 16px;
    }

    .sticky-atc__price-compare {
      font-size: 13px;
    }

    .sticky-atc__variant-select {
      min-width: 120px;
      font-size: 13px;
      padding: 8px 10px;
    }

    .sticky-atc__qty-btn {
      width: 28px;
      height: 28px;
    }

    .sticky-atc__qty-input {
      width: 34px;
      height: 28px;
      font-size: 12px;
    }

    .sticky-atc__button {
      padding: 9px 11px;
      font-size: 14px;
      flex: 1.5;
    }
  }

  @media (max-width: 480px) {
    .sticky-atc {
      max-width: 208px;
    }

    .sticky-atc__image {
      width: 54px;
      height: 54px;
    }

    .sticky-atc__info {
      flex: 1;
      min-width: 0;
    }

    .sticky-atc__title {
      font-size: 13px;
    }

    .sticky-atc__variant-select {
      font-size: 12px;
      padding: 7px 8px;
    }

    .sticky-atc__button-text {
      display: none;
    }

    .sticky-atc__qty-btn {
      width: 24px;
      height: 24px;
    }

    .sticky-atc__qty-input {
      width: 28px;
      height: 24px;
      font-size: 11px;
    }

    .sticky-atc__button {
      padding: 9px 11px;
      min-width: 54px;
      justify-content: center;
      flex: 1.5;
    }
  }
  </style>

  <script>
  (function() {
    'use strict';

    // Wait for DOM to be fully loaded
    function initStickyATC() {
      const stickyATC = document.getElementById('sticky-add-to-cart-{{ product.id }}');
      if (!stickyATC) return;

    const productHandle = stickyATC.dataset.productHandle;
    const productId = stickyATC.dataset.productId;

    // Find header element (multiple selectors for different themes)
    const headerElement =
      document.querySelector('header.header') ||
      document.querySelector('.shopify-section-header') ||
      document.querySelector('#shopify-section-header') ||
      document.querySelector('header') ||
      document.querySelector('[data-section-type="header"]');

    // Find main add to cart button (try multiple selectors for different themes)
    const mainATCButton =
      document.querySelector('button[name="add"]') || // Dawn theme
      document.querySelector('form[action="/cart/add"] button[type="submit"]') || // Classic themes
      document.querySelector('.product-form__submit') || // Some themes
      document.querySelector('[data-add-to-cart]') || // Custom implementations
      document.querySelector('button:has-text("Add to cart")'); // Fallback

    // If no main button found, show sticky always (as fallback)
    const hasMainButton = !!mainATCButton;
    const hasHeader = !!headerElement;

    // State flags
    let isHeaderHidden = !hasHeader; // If no header found, consider it hidden (allow widget)
    let isMainButtonHidden = false;

    // Elements
    const variantSelect = stickyATC.querySelector('[data-sticky-variant-select]');
    const quantityInput = stickyATC.querySelector('[data-sticky-quantity]');
    const addButton = stickyATC.querySelector('[data-sticky-add-to-cart]');
    const buttonText = stickyATC.querySelector('[data-sticky-button-text]');
    const priceDisplay = stickyATC.querySelector('[data-sticky-price]');
    const qtyBtns = stickyATC.querySelectorAll('[data-qty-change]');

    // GA4 Tracking Helper
    function trackGA4Event(eventName, params) {
      if (typeof gtag !== 'undefined') {
        gtag('event', eventName, params);
      } else if (typeof window.dataLayer !== 'undefined') {
        window.dataLayer.push({
          'event': eventName,
          ...params
        });
      }
    }

    // Function to update widget visibility based on both conditions
    function updateWidgetVisibility() {
      if (isHeaderHidden && isMainButtonHidden) {
        // Both header and main button out of view - show sticky
        stickyATC.classList.add('is-visible');

        // Track sticky bar view (only once)
        if (!stickyATC.dataset.tracked) {
          trackGA4Event('view_sticky_add_to_cart', {
            'event_category': 'sticky_atc',
            'product_handle': productHandle,
            'product_id': productId
          });
          stickyATC.dataset.tracked = 'true';
        }
      } else {
        // Header or main button in view - hide sticky
        stickyATC.classList.remove('is-visible');
      }
    }

    // Intersection Observer for Header
    if (hasHeader) {
      const headerObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          isHeaderHidden = !entry.isIntersecting;
          updateWidgetVisibility();
        });
      }, {
        threshold: 0,
        rootMargin: '0px'
      });

      headerObserver.observe(headerElement);
    }

    // Intersection Observer for Main Add to Cart Button
    if (hasMainButton) {
      const buttonObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          isMainButtonHidden = !entry.isIntersecting;
          updateWidgetVisibility();
        });
      }, {
        threshold: 0,
        rootMargin: '-100px 0px 0px 0px'
      });

      buttonObserver.observe(mainATCButton);
    } else {
      // No main button found - show sticky after delay (fallback behavior)
      // But still wait for header to disappear
      setTimeout(() => {
        isMainButtonHidden = true;
        updateWidgetVisibility();
        if (isHeaderHidden && isMainButtonHidden) {
          trackGA4Event('view_sticky_add_to_cart', {
            'event_category': 'sticky_atc',
            'product_handle': productHandle,
            'product_id': productId,
            'fallback_mode': true
          });
        }
      }, 1000);
    }

    // Quantity Controls
    qtyBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const change = parseInt(this.dataset.qtyChange);
        const currentQty = parseInt(quantityInput.value) || 1;
        const newQty = Math.max(1, currentQty + change);
        quantityInput.value = newQty;

        // Track quantity change
        trackGA4Event('change_sticky_quantity', {
          'event_category': 'sticky_atc',
          'product_handle': productHandle,
          'quantity': newQty
        });
      });
    });

    // Variant Change - Update Price
    if (variantSelect) {
      variantSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        const price = selectedOption.dataset.price;
        const comparePrice = selectedOption.dataset.comparePrice;

        // Update price display
        updatePriceDisplay(price, comparePrice);

        // Update button state
        if (selectedOption.disabled) {
          addButton.disabled = true;
          buttonText.textContent = 'Sold Out';
        } else {
          addButton.disabled = false;
          buttonText.textContent = 'Add to Cart';
        }

        // Track variant change
        trackGA4Event('change_sticky_variant', {
          'event_category': 'sticky_atc',
          'product_handle': productHandle,
          'variant_id': this.value
        });
      });
    }

    // Format money helper (cents to dollars)
    function formatMoney(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    function updatePriceDisplay(price, comparePrice) {
      const priceValue = parseInt(price);
      const comparePriceValue = parseInt(comparePrice);

      let html = '';

      if (comparePriceValue && comparePriceValue > priceValue) {
        const discountPercent = Math.round(((comparePriceValue - priceValue) / comparePriceValue) * 100);
        html = `
          <span class="sticky-atc__price-compare">${formatMoney(comparePriceValue)}</span>
          <span class="sticky-atc__price-current">${formatMoney(priceValue)}</span>
          <span class="sticky-atc__price-badge">-${discountPercent}%</span>
        `;
      } else {
        html = `<span class="sticky-atc__price-current">${formatMoney(priceValue)}</span>`;
      }

      priceDisplay.innerHTML = html;
    }

    // Add to Cart
    addButton.addEventListener('click', async function() {
      if (this.disabled) return;

      // Show loading state
      this.classList.add('is-loading');

      const variantId = variantSelect ? variantSelect.value : '{{ product.selected_or_first_available_variant.id }}';
      const quantity = parseInt(quantityInput.value) || 1;

      try {
        // Add to cart via Shopify API
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: quantity
          })
        });

        if (!response.ok) {
          throw new Error('Failed to add to cart');
        }

        const data = await response.json();

        // Track successful add to cart
        trackGA4Event('add_to_cart_sticky', {
          'event_category': 'sticky_atc',
          'product_handle': productHandle,
          'variant_id': variantId,
          'quantity': quantity,
          'price': data.price / 100
        });

        // Update cart count (if theme has cart drawer)
        if (typeof window.updateCart === 'function') {
          window.updateCart();
        }

        // Open cart drawer (if theme supports it)
        if (typeof window.openCartDrawer === 'function') {
          window.openCartDrawer();
        } else {
          // Fallback: Dispatch custom event
          document.dispatchEvent(new CustomEvent('cart:refresh'));
        }

        // Visual feedback
        this.classList.remove('is-loading');
        const originalText = buttonText.textContent;
        buttonText.textContent = 'Added!';

        setTimeout(() => {
          buttonText.textContent = originalText;
        }, 2000);

      } catch (error) {
        console.error('Sticky ATC error:', error);
        this.classList.remove('is-loading');
        buttonText.textContent = 'Error - Try Again';

        setTimeout(() => {
          buttonText.textContent = 'Add to Cart';
        }, 3000);
      }
    });

    // Sync with main form variant changes (if theme updates main form)
    const mainForm = document.querySelector('form[action="/cart/add"]');
    if (mainForm) {
      const mainVariantInput = mainForm.querySelector('[name="id"]');
      if (mainVariantInput) {
        // Listen for changes to main variant selector
        mainVariantInput.addEventListener('change', function() {
          if (variantSelect) {
            variantSelect.value = this.value;
            variantSelect.dispatchEvent(new Event('change'));
          }
        });
      }
    }
    } // End initStickyATC function

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyATC);
    } else {
      // DOM already loaded, init immediately
      initStickyATC();
    }

  })();
  </script>

{%- endif -%}
